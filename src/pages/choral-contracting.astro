---
import Layout from '../layouts/Layout.astro';
import Staff from '../components/Staff.astro';
import Closing from '../components/Closing.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  serviceType: 'Choral Contracting',
  name: 'Nate Adams, NYC Choral Contractor',
  url: new URL('/choral-contracting/', Astro.site).href,
  image: new URL('/images/choral-contracting-hero.jpg', Astro.site).href,
  email: 'nathanielbadams@gmail.com',
  foundingDate: '2010',
  description:
    'Choral contracting services in New York City: hiring choirs and vocalists for live tapings, concerts, corporate events, and recordings.',
  provider: {
    '@type': 'Person',
    name: 'Nate Adams',
    alternateName: 'Nathaniel Adams',
    url: new URL('/', Astro.site).href,
  },
  areaServed: {
    '@type': 'City',
    name: 'New York City',
  },
};

const collaborators = ['Madonna', 'Hans Zimmer', 'Jackie Chan'];
const venues = ['Carnegie Hall', 'Madison Square Garden', 'Radio City Music Hall', 'Lincoln Center'];
const media = ['The Tonight Show Starring Jimmy Fallon', 'The Daily Show'];
const clients = ['NBC Universal', 'Accenture', 'Sundance Film Festival'];
const mailto = 'mailto:nathanielbadams@gmail.com?subject=Choral%20contracting%20inquiry';
const dev = import.meta.env.DEV;
const credits = [
  ...venues.map((name) => ({ type: 'Venue', name })),
  ...media.map((name) => ({ type: 'Television', name })),
  ...clients.map((name) => ({ type: 'Client', name })),
];
---
<Layout
  title="NYC Choral Contractor | Nate Adams"
  description="Nate Adams is a New York City choral contractor hiring choirs and vocalists for live tapings, concerts, and corporate events at venues including Carnegie Hall, Madison Square Garden, and Radio City Music Hall."
  image="/images/choral-contracting-hero.jpg"
  jsonLd={jsonLd}
>
  <section class="header">
    <Staff />
    <div class="wrap header-inner">
      <h1 class="display origin rise">NYC choral contractor</h1>
      <p class="lede rise rise-2">
        I hire and coordinate professional singers for television tapings, concerts, and events
        across New York City, from a quartet to a full chorus.
      </p>
      <a class="btn rise rise-3" href={mailto}>Email about your project</a>
    </div>
  </section>

  <img
    class="band-photo"
    src="/images/choral-contracting-hero.jpg"
    alt="Nate Adams with a vocal ensemble during a professional recording session in New York City"
    width="1600"
    height="900"
  />

  <section class="wrap grid block">
    <div class="lead">
      <p class="prose">
        Since 2010 I have contracted vocal ensembles for national television, corporate events, and
        major concert engagements, working closely with producers and music directors to staff the
        right singers for every room and every score.
      </p>
    </div>
    <div class="rail since">
      <p class="label">Contracting since</p>
      <span class="figure-n">2010</span>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="worked-with">
    <h2 id="worked-with" class="origin h2">Worked with</h2>
    <ul class="names">
      {collaborators.map((n) => <li>{n}</li>)}
    </ul>
    <div class="photos">
      <figure>
        <img
          src="/images/nate-adams-hans-zimmer-2017.jpg"
          alt="Nate Adams and Hans Zimmer taking a selfie in a hallway at Radio City Music Hall"
          width="960"
          height="1280"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          With Hans Zimmer at Radio City Music Hall, July 2017. I contracted the choir for his two
          concerts there.
        </figcaption>
      </figure>
      <figure>
        <img
          src="/images/radio-city-hans-zimmer-2017.jpg"
          alt="The Radio City Music Hall marquee at night, announcing Hans Zimmer on July 25 and 26"
          width="960"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <figcaption>The marquee for the two nights, July 25 and 26.</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap grid block">
    <div class="lead">
      <h2 class="origin h2">Credits</h2>
      <table class="table">
        <thead>
          <tr><th scope="col">Type</th><th scope="col">Name</th></tr>
        </thead>
        <tbody>
          {credits.map((c) => <tr><td>{c.type}</td><td>{c.name}</td></tr>)}
        </tbody>
      </table>
    </div>
    <div class="rail highlights">
      <h2 class="origin h2">Highlights</h2>
      <ul class="list">
        <li>Performed at the 2018 Met Gala alongside Madonna, with the Clarion Music Society</li>
        <li>Regular concert performances with the New York Philharmonic at Lincoln Center and Carnegie Hall</li>
        <li>Provided music for the inaugurations of Celebrity Cruises' Equinox and Eclipse</li>
      </ul>
    </div>
  </section>

  {dev && (
    <section class="wrap block">
      <div class="placeholder">
        Projects go here: 3 or 4 short write-ups (event, venue, year, ensemble size), then a short FAQ.
        Only visible in local dev.
      </div>
    </section>
  )}

  <Closing
    title="Planning a taping, concert, or event?"
    text="Tell me the date, the venue, and the music, and I will put together the right singers."
    href={mailto}
  />
</Layout>

<style>
  .since {
    margin-top: 2.5rem;
  }

  @media (min-width: 834px) {
    .since {
      margin-top: 0;
    }
  }

  .names {
    list-style: none;
    margin: 0;
    padding: 0;
    font: 800 clamp(2.4rem, 6.5vw, 5.4rem)/0.98 var(--head);
    letter-spacing: -0.03em;
  }

  /* A portrait and a landscape photo side by side at the same height:
     column widths in the ratio 3/4 : 4/3, which is 9 : 16. */
  .photos {
    display: grid;
    gap: 2rem var(--gut);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 834px) {
    .photos {
      grid-template-columns: 9fr 16fr;
    }
  }

  .photos figure {
    margin: 0;
  }

  .photos img {
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.08);
  }

  .photos figcaption {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .highlights {
    margin-top: 3rem;
  }

  @media (min-width: 834px) {
    .highlights {
      margin-top: 0;
    }
  }

  .placeholder {
    border: 1px dashed var(--verm);
    color: var(--verm);
    padding: 1.25rem;
  }
</style>
