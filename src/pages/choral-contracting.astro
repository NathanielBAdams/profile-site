---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  serviceType: 'Choral Contracting',
  name: 'Nate Adams, NYC Choral Contractor',
  url: new URL('/choral-contracting/', Astro.site).href,
  image: new URL('/images/choral-contracting-hero.jpg', Astro.site).href,
  email: 'nathanielbadams@gmail.com',
  foundingDate: '2010',
  description:
    'Choral contracting services in New York City: hiring choirs and vocalists for live tapings, concerts, corporate events, and recordings.',
  provider: {
    '@type': 'Person',
    name: 'Nate Adams',
    alternateName: 'Nathaniel Adams',
    url: new URL('/', Astro.site).href,
  },
  areaServed: {
    '@type': 'City',
    name: 'New York City',
  },
};

const collaborators = ['Madonna', 'Hans Zimmer', 'Jackie Chan'];
const venues = ['Carnegie Hall', 'Madison Square Garden', 'Radio City Music Hall', 'Lincoln Center'];
const media = ['The Tonight Show Starring Jimmy Fallon', 'The Daily Show'];
const clients = ['NBC Universal', 'Accenture', 'Sundance Film Festival'];
const mailto = 'mailto:nathanielbadams@gmail.com?subject=Choral%20contracting%20inquiry';
const dev = import.meta.env.DEV;
---
<Layout
  title="NYC Choral Contractor | Nate Adams"
  description="Nate Adams is a New York City choral contractor hiring choirs and vocalists for live tapings, concerts, and corporate events at venues including Carnegie Hall, Madison Square Garden, and Radio City Music Hall."
  image="/images/choral-contracting-hero.jpg"
  jsonLd={jsonLd}
>
  <section class="page header">
    <h1 class="display">NYC choral contractor</h1>
    <p class="lede">
      I hire and coordinate professional singers for television tapings, concerts, and events
      across New York City, from a quartet to a full chorus.
    </p>
    <a class="button" href={mailto}>Email about your project</a>
  </section>

  <div class="page">
    <Frame>
      <img
        class="hero-image"
        src="/images/choral-contracting-hero.jpg"
        alt="Nate Adams with a vocal ensemble during a professional recording session in New York City"
        width="1600"
        height="900"
      />
    </Frame>
  </div>

  <section class="page since">
    <p>
      Since 2010 I have contracted vocal ensembles for national television, corporate events, and
      major concert engagements, working closely with producers and music directors to staff the
      right singers for every room and every score.
    </p>
  </section>

  <section class="page worked" aria-labelledby="worked-with">
    <h2 id="worked-with" class="muted worked-label">Worked with</h2>
    <ul class="names">
      {collaborators.map((n) => <li>{n}</li>)}
    </ul>
  </section>

  <section class="page rows">
    <div class="row">
      <h2 class="row-label">Venues</h2>
      <div class="row-body"><ul>{venues.map((v) => <li>{v}</li>)}</ul></div>
    </div>
    <div class="row">
      <h2 class="row-label">Television</h2>
      <div class="row-body"><ul>{media.map((m) => <li>{m}</li>)}</ul></div>
    </div>
    <div class="row">
      <h2 class="row-label">Clients</h2>
      <div class="row-body"><ul>{clients.map((c) => <li>{c}</li>)}</ul></div>
    </div>
    <div class="row">
      <h2 class="row-label">Highlights</h2>
      <div class="row-body">
        <ul>
          <li>Performed at the 2018 Met Gala alongside Madonna, with the Clarion Music Society</li>
          <li>Regular concert performances with the New York Philharmonic at Lincoln Center and Carnegie Hall</li>
          <li>Provided music for the inaugurations of Celebrity Cruises' Equinox and Eclipse</li>
        </ul>
      </div>
    </div>
    {dev && (
      <div class="row">
        <h2 class="row-label">Projects</h2>
        <div class="row-body placeholder">
          3 or 4 short write-ups go here (event, venue, year, ensemble size), then a short FAQ.
          Only visible in local dev.
        </div>
      </div>
    )}
  </section>

  <section class="page closing">
    <h2 class="closing-title">Planning a taping, concert, or event?</h2>
    <p>Tell me the date, the venue, and the music, and I will put together the right singers.</p>
    <a class="button" href={mailto}>Email nathanielbadams@gmail.com</a>
  </section>
</Layout>

<style>
  .hero-image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .since {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .since p {
    max-width: var(--measure);
    font-size: clamp(1.1rem, 1.8vw, 1.25rem);
    line-height: 1.5;
  }

  .worked {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .worked-label {
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    margin-bottom: 0.75rem;
  }

  .names {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.28em;
    font-size: clamp(2.4rem, 7vw, 5rem);
    font-stretch: 78%;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .names li:not(:last-child)::after {
    content: ',';
    color: var(--slate);
  }

  .placeholder {
    border: 1px dashed var(--steel);
    color: var(--steel);
    padding: 1rem;
  }
</style>
