---
import Layout from '../layouts/Layout.astro';
import Staff from '../components/Staff.astro';
import Closing from '../components/Closing.astro';
import Traced from '../components/Traced.astro';
import bandOutline from '../data/outlines/choral-contracting-hero.json';
import zimmerOutline from '../data/outlines/nate-adams-hans-zimmer-2017.json';
import singersOutline from '../data/outlines/radio-city-hans-zimmer-singers-2017.json';
import fallonOutline from '../data/outlines/tonight-show-starring-jimmy-fallon.json';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  serviceType: 'Choral Contracting',
  name: 'Nate Adams, NYC Choral Contractor',
  url: new URL('/choral-contracting/', Astro.site).href,
  image: new URL('/images/choral-contracting-hero.jpg', Astro.site).href,
  email: 'nathanielbadams@gmail.com',
  foundingDate: '2010',
  description:
    'Choral contracting services in New York City: hiring choirs and vocalists for live tapings, concerts, corporate events, and recordings.',
  provider: {
    '@type': 'Person',
    name: 'Nate Adams',
    alternateName: 'Nathaniel Adams',
    url: new URL('/', Astro.site).href,
  },
  areaServed: {
    '@type': 'City',
    name: 'New York City',
  },
};

// A credit with `shows` points to the photo whose data-photo includes that id
// (hover draws a line to it). If no such photo is on the page, nothing happens.
const collaborators = [
  { name: 'Madonna' },
  { name: 'Hans Zimmer', shows: 'hans-zimmer' },
  { name: 'Jackie Chan' },
  { name: 'Vampire Weekend', shows: 'vampire-weekend' },
];
const shows: Record<string, string> = {
  'Carnegie Hall': 'carnegie-hall',
  'Radio City Music Hall': 'radio-city',
  'The Tonight Show Starring Jimmy Fallon': 'tonight-show',
};
const venues = ['Carnegie Hall', 'Madison Square Garden', 'Radio City Music Hall', 'Lincoln Center'];
const media = ['The Tonight Show Starring Jimmy Fallon', 'The Daily Show'];
const clients = ['NBC Universal', 'Accenture', 'Sundance Film Festival'];
const mailto = 'mailto:nathanielbadams@gmail.com?subject=Choral%20contracting%20inquiry';
const dev = import.meta.env.DEV;
const credits = [
  ...venues.map((name) => ({ type: 'Venue', name })),
  ...media.map((name) => ({ type: 'Television', name })),
  ...clients.map((name) => ({ type: 'Client', name })),
];
---
<Layout
  title="NYC Choral Contractor | Nate Adams"
  description="Nate Adams is a New York City choral contractor hiring choirs and vocalists for live tapings, concerts, and corporate events at venues including Carnegie Hall, Madison Square Garden, and Radio City Music Hall."
  image="/images/choral-contracting-hero.jpg"
  jsonLd={jsonLd}
>
  <section class="header">
    <Staff />
    <div class="wrap header-inner">
      <h1 class="display origin staffed rise"><span data-page-title>NYC choral contractor</span></h1>
      <p class="lede staffed rise rise-2">
        I hire and coordinate professional singers for television tapings, concerts, and events
        across New York City, from a quartet to a full chorus.
      </p>
      <a class="btn staffed rise rise-3" href={mailto}>Email about your project</a>
    </div>
  </section>

  <Traced outline={bandOutline} alt="Nate Adams with a vocal ensemble during a professional recording session in New York City. Nate is in the plaid shirt and cap, giving a thumbs up." cover label lazy={false} />

  <section class="wrap grid block">
    <div class="lead">
      <p class="prose">
        Since 2010 I've hired singers for television, concerts, and corporate events, working with
        producers and music directors to find the right voices for each project.
      </p>
    </div>
    <div class="rail since">
      <p class="label">Contracting since</p>
      <span class="figure-n">2010</span>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="worked-with">
    <h2 id="worked-with" class="origin h2">Worked with</h2>
    <ul class="names">
      {collaborators.map((c) => <li data-shows={c.shows}>{c.name}</li>)}
    </ul>
    <!-- Equal heights: column widths follow each photo's width-to-height ratio. -->
    <div class="photos" style="--cols: 9fr 9fr 16fr">
      <figure data-photo="hans-zimmer">
        <Traced outline={zimmerOutline} alt="Nate Adams, right, in glasses, and Hans Zimmer taking a selfie in a hallway at Radio City Music Hall" />
        <figcaption>
          With Hans Zimmer at Radio City Music Hall, July 2017. I contracted the choir for his two
          concerts there.
        </figcaption>
      </figure>
      <figure>
        <Traced outline={singersOutline} alt="Nate Adams, center, and fellow singers in black, wearing headset microphones, seated together for the Hans Zimmer concerts" label />
        <figcaption>Some of the singers on those concerts, me among them.</figcaption>
      </figure>
      <figure data-photo="radio-city">
        <div class="photo-frame">
          <img
            src="/images/radio-city-hans-zimmer-2017.jpg"
            alt="The Radio City Music Hall marquee at night, announcing Hans Zimmer on July 25 and 26"
            width="960"
            height="720"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>The marquee for the two nights, July 25 and 26.</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap grid block">
    <div class="lead">
      <h2 class="origin h2">Credits</h2>
      <table class="table">
        <thead>
          <tr><th scope="col">Type</th><th scope="col">Name</th></tr>
        </thead>
        <tbody>
          {credits.map((c) => <tr data-shows={shows[c.name]}><td>{c.type}</td><td data-shows-text>{c.name}</td></tr>)}
        </tbody>
      </table>
      <div class="photos" style="--cols: 9fr 12fr">
        <figure data-photo="carnegie-hall">
          <div class="photo-frame">
            <img
              src="/images/carnegie-hall-stage.jpg"
              alt="View from the chorus seats on the Carnegie Hall stage during a Final Fantasy concert: the orchestra, a full house, and the lit tiers and ceiling above"
              width="800"
              height="1422"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>Final Fantasy at Carnegie Hall. I contracted the choir and sang in it.</figcaption>
        </figure>
        <figure data-photo="tonight-show vampire-weekend">
          <Traced outline={fallonOutline} alt="Nate Adams in a hard hat and safety vest beside The Tonight Show Starring Jimmy Fallon sign" />
          <figcaption>Singing backup for Vampire Weekend on The Tonight Show Starring Jimmy Fallon.</figcaption>
        </figure>
      </div>
    </div>
    <div class="rail highlights">
      <h2 class="origin h2">Selected work</h2>
      <ul class="list">
        <li>Sang with the Clarion Music Society at the 2018 Met Gala, performing with Madonna</li>
        <li data-shows="vampire-weekend">Sang backup for Vampire Weekend on The Tonight Show Starring Jimmy Fallon</li>
        <li>Regular concerts with the New York Philharmonic at Lincoln Center and Carnegie Hall</li>
        <li>Music for the inaugurations of Celebrity Cruises' Equinox and Eclipse</li>
      </ul>
    </div>
  </section>

  {dev && (
    <section class="wrap block">
      <div class="placeholder">
        Projects go here: 3 or 4 short write-ups (event, venue, year, ensemble size), then a short FAQ.
        Only visible in local dev.
      </div>
    </section>
  )}

  <Closing
    title="Planning a taping, concert, or event?"
    text="Tell me the date, the venue, and the music, and I will put together the right singers."
    href={mailto}
  />
</Layout>

<style>
  .since {
    margin-top: 2.5rem;
  }

  @media (min-width: 834px) {
    .since {
      margin-top: 0;
    }
  }

  .names {
    list-style: none;
    margin: 0;
    padding: 0;
    font: 800 clamp(2.4rem, 6.5vw, 5.4rem)/0.98 var(--head);
    letter-spacing: -0.03em;
  }

  .highlights {
    margin-top: 3rem;
  }

  @media (min-width: 834px) {
    .highlights {
      margin-top: 0;
    }
  }

  .placeholder {
    border: 1px dashed var(--verm);
    color: var(--verm);
    padding: 1.25rem;
  }
</style>
