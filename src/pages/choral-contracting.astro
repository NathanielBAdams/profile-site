---
import Layout from '../layouts/Layout.astro';
import { subtitles } from '../data/subtitles';
import Staff from '../components/Staff.astro';
import Closing from '../components/Closing.astro';
import Traced from '../components/Traced.astro';
import bandOutline from '../data/outlines/choral-contracting-hero.json';
import zimmerOutline from '../data/outlines/nate-adams-hans-zimmer-2017.json';
import hansOutline from '../data/outlines/hans-zimmer-2017.json';

// What I book singers for. Shown on the page and listed in the structured
// data, so search engines see the same services a visitor does.
const services = [
  { name: 'Television tapings', text: 'Choirs and backup singers for network and late-night television.' },
  { name: 'Concerts', text: 'Choirs for concert stages, from Carnegie Hall to Madison Square Garden.' },
  { name: 'Recording sessions', text: 'Singers for studio and location recordings, from a few voices to a full chorus.' },
  { name: 'Events', text: 'Ensembles for corporate events, galas, and launches.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  serviceType: 'Choral Contracting',
  name: 'Nate Adams, NYC Choral Contractor',
  alternateName: 'Nathaniel Adams, choir contractor in New York City',
  url: new URL('/choral-contracting/', Astro.site).href,
  image: new URL('/images/choral-contracting-hero.jpg', Astro.site).href,
  email: 'nathanielbadams@gmail.com',
  foundingDate: '2010',
  description:
    'Choral contracting services in New York City: hiring choirs and vocalists for live tapings, concerts, corporate events, and recordings.',
  provider: {
    '@type': 'Person',
    name: 'Nate Adams',
    alternateName: 'Nathaniel Adams',
    url: new URL('/', Astro.site).href,
  },
  areaServed: {
    '@type': 'City',
    name: 'New York City',
  },
  knowsAbout: ['Choral contracting', 'Hiring choirs', 'Professional singers', 'Backup singers', 'Session singers'],
  sameAs: ['https://www.linkedin.com/in/adamsnathaniel/'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Choral contracting services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name, description: s.text, areaServed: 'New York City' },
    })),
  },
};

// A credit with `shows` points to the photo whose data-photo includes that id
// (hover draws a line to it). If no such photo is on the page, nothing happens.
const productions = [
  { name: 'Hans Zimmer', venue: 'Radio City Music Hall', shows: 'hans-zimmer' },
  { name: 'Final Fantasy', venue: 'Carnegie Hall', shows: 'carnegie-hall' },
  { name: 'Game of Thrones', venue: 'Live Concert Experience with Ramin Djawadi, Madison Square Garden' },
];
const mailto = 'mailto:nathanielbadams@gmail.com?subject=Choral%20contracting%20inquiry';
const dev = import.meta.env.DEV;
---
<Layout
  title="NYC Choral Contractor: Hire a Choir or Singers | Nate Adams"
  description="Hire a choir in New York City. Choral contractor Nate Adams books professional singers, from a quartet to a full chorus, for TV, concerts, recordings, and events."
  image="/images/choral-contracting-hero.jpg"
  jsonLd={jsonLd}
>
  <section class="header">
    <Staff />
    <div class="wrap header-inner">
      <h1 class="display origin staffed rise" data-page-title>NYC choral contractor</h1>
      <p class="lede staffed rise rise-2">{subtitles.contracting}</p>
      <a class="btn staffed rise rise-3" href={mailto}>Email about your project</a>
    </div>
  </section>

  <Traced outline={bandOutline} alt="Nate Adams with a vocal ensemble he contracted for a recording session in New York City. Nate is in the plaid shirt and cap, giving a thumbs up." cover label lazy={false} />

  <section class="wrap grid block">
    <div class="lead">
      <p class="prose">
        Since 2010 I've worked with producers and music directors to find the right voices for each
        project, on stage, in the studio, and on camera.
      </p>
    </div>
    <div class="rail since">
      <p class="label">Contracting since</p>
      <span class="figure-n">2010</span>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="hire">
    <h2 id="hire" class="origin h2">Hire a choir in New York</h2>
    <p class="prose hire-intro">
      Tell me the date, the venue, and the music. I'll put together the right singers for it, from a
      quartet to a full chorus.
    </p>
    <ul class="grid services">
      {services.map((s) => (
        <li class="service">
          <h3 class="service-name">{s.name}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block" aria-labelledby="contracted-for">
    <h2 id="contracted-for" class="origin h2">Choirs contracted for</h2>
    <ul class="productions">
      {productions.map((p) => (
        <li data-shows={p.shows}>
          <span class="production-name" data-shows-text>{p.name}</span>
          <span class="production-venue">{p.venue}</span>
        </li>
      ))}
    </ul>
    <!-- Equal heights: column widths follow each photo's width-to-height ratio. -->
    <div class="photos" style="--cols: 9fr 16fr 6.75fr">
      <figure data-photo="hans-zimmer">
        <Traced outline={zimmerOutline} friend={{ outline: hansOutline, label: 'That’s Hans' }} label alt="Nate Adams, right, in glasses, and Hans Zimmer taking a selfie in a hallway at Radio City Music Hall" />
        <figcaption>
          With Hans Zimmer at Radio City Music Hall, July 2017, where I put together the choir for
          his two concerts.
        </figcaption>
      </figure>
      <figure data-photo="radio-city">
        <div class="photo-frame">
          <img
            src="/images/radio-city-hans-zimmer-2017.jpg"
            alt="The Radio City Music Hall marquee at night, announcing Hans Zimmer on July 25 and 26"
            width="960"
            height="720"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>The marquee for the two nights, July 25 and 26.</figcaption>
      </figure>
      <figure data-photo="carnegie-hall">
        <div class="photo-frame">
          <img
            src="/images/carnegie-hall-stage.jpg"
            alt="View from the chorus seats on the Carnegie Hall stage during a Final Fantasy concert: the orchestra, a full house, and the lit tiers and ceiling above"
            width="800"
            height="1422"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>Final Fantasy at Carnegie Hall, from inside the choir I put together.</figcaption>
      </figure>
    </div>
    <p class="also">
      I also sing with ensembles across New York. See <a href="/performance/">Performance</a>.
    </p>
  </section>

  {dev && (
    <section class="wrap block">
      <div class="placeholder">
        Projects go here: 3 or 4 short write-ups (event, venue, year, ensemble size), then a short FAQ.
        Only visible in local dev.
      </div>
    </section>
  )}

  <Closing
    title="Planning a taping, concert, or event?"
    text="Tell me the date, the venue, and the music, and I will put together the right singers."
    href={mailto}
  />
</Layout>

<style>
  .since {
    margin-top: 2.5rem;
  }

  @media (min-width: 834px) {
    .since {
      margin-top: 0;
    }
  }

  .productions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .productions li {
    display: grid;
    gap: 0.35rem;
  }

  .production-name {
    font: 800 clamp(2.4rem, 6.5vw, 5.4rem)/0.98 var(--head);
    letter-spacing: -0.03em;
  }

  .production-venue {
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
  }

  .also {
    margin-top: 2rem;
    color: var(--muted);
  }

  .hire-intro {
    max-width: 38rem;
    margin-bottom: 2.25rem;
  }

  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    row-gap: 2rem;
  }

  .service {
    grid-column: 1 / -1;
    border-top: 2px solid var(--ink);
    padding-top: 0.9rem;
  }

  @media (min-width: 834px) {
    .service {
      grid-column: span 6;
    }
  }

  @media (min-width: 1200px) {
    .service {
      grid-column: span 3;
    }
  }

  .service-name {
    font: 700 1.25rem/1.2 var(--head);
    margin-bottom: 0.5rem;
  }

  .service p {
    color: var(--muted);
  }

  .placeholder {
    border: 1px dashed var(--verm);
    color: var(--verm);
    padding: 1.25rem;
  }
</style>
