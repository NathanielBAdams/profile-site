---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
---
<Layout
  title="Nate Adams — Choral Contractor, Composer & Software Engineer"
  description="Nate Adams is a NYC-based choral contractor, composer, and software engineer. He hires choirs and vocalists for live tapings, concerts, and events at venues including Carnegie Hall, Radio City, and Madison Square Garden."
>
  <Section>
    <h1 class="hero-heading">Hi, I'm Nate 👋</h1>
    <p class="hero-text">
      I'm a choral contractor, composer, and software engineer based in NYC.
      This site is a little corner for my work, music, and weekly dough rituals.
    </p>
  </Section>
</Layout>

<style>
  .hero-heading {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .hero-text {
    font-size: 1.25rem;
    line-height: 1.6;
    color: #333;
  }
</style>
