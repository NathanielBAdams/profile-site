---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import Instrument from '../components/Instrument.astro';

const home = new URL('/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nate Adams',
  alternateName: 'Nathaniel Adams',
  url: home,
  image: new URL('/images/profile-photo.jpg', Astro.site).href,
  jobTitle: ['Choral Contractor', 'Composer', 'Software Engineer'],
  worksFor: { '@type': 'Organization', name: 'Datadog', url: 'https://www.datadoghq.com/' },
  address: { '@type': 'PostalAddress', addressLocality: 'New York', addressRegion: 'NY', addressCountry: 'US' },
  knowsAbout: ['Choral contracting', 'Choral composition', 'Software engineering'],
  sameAs: ['https://www.linkedin.com/in/adamsnathaniel/'],
};

const areas = [
  {
    title: 'Choral contracting',
    href: '/choral-contracting/',
    text: 'I hire and coordinate professional singers for television tapings, concerts, and events at Carnegie Hall, Radio City Music Hall, and Madison Square Garden.',
  },
  {
    title: 'Music',
    href: '/music/',
    text: 'I write choral music, published by Walton Music and Gentry Publications, and sing professionally in New York.',
  },
  {
    title: 'Software',
    href: '/software/',
    text: 'I work on front-end engineering and product design at Datadog, building AI-assisted workflows for Cloud SIEM.',
  },
];
---
<Layout
  title="Nate Adams | NYC Choral Contractor, Composer & Software Engineer"
  description="Nate Adams is a NYC-based choral contractor, composer, and software engineer. He hires choirs and vocalists for live tapings, concerts, and events at venues including Carnegie Hall, Radio City, and Madison Square Garden."
  image="/images/profile-photo.jpg"
  jsonLd={jsonLd}
>
  <section class="page hero">
    <Instrument class="rings" tuner />
    <div class="hero-text">
      <h1 class="name">Nate Adams</h1>
      <p class="role">Choral contractor, composer, and software engineer in New York City.</p>
    </div>
    <div class="hero-side">
      <Frame class="portrait">
        <img src="/images/profile-photo.jpg" alt="Portrait of Nate Adams" width="320" height="320" />
      </Frame>
    </div>
  </section>

  <section class="page areas" aria-label="What I do">
    {areas.map((a) => (
      <a class="area" href={a.href}>
        <h2 class="area-title">{a.title}</h2>
        <p class="area-text">{a.text}</p>
      </a>
    ))}
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: end;
    padding-top: clamp(3rem, 10vw, 8rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  .hero :global(.rings) {
    position: absolute;
    width: min(46rem, 120vw);
    right: -12rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: -1;
  }

  .name {
    font-size: clamp(3.6rem, 13vw, 9.5rem);
    font-stretch: 78%;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.88;
  }

  .name,
  .role {
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .name {
    animation-delay: 0.1s;
  }

  .role {
    animation-delay: 0.35s;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
  }

  .role {
    margin-top: 1.5rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--slate);
    max-width: 26ch;
    line-height: 1.35;
  }

  .hero :global(.portrait) {
    width: min(16rem, 60vw);
  }

  .hero :global(.portrait img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  @media (min-width: 800px) {
    .hero {
      grid-template-columns: 1fr auto;
    }
  }

  .areas {
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .area {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--ice);
    text-decoration: none;
  }

  .area:last-child {
    border-bottom: 1px solid var(--ice);
  }

  .area-title {
    font-size: 1.5rem;
    font-stretch: 85%;
  }

  .area-text {
    color: var(--slate);
    max-width: var(--measure);
  }

  .area::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--steel);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .area-title {
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      color 0.3s ease;
  }

  .area:hover {
    color: inherit;
  }

  .area:hover::before,
  .area:focus-visible::before {
    transform: scaleX(1);
  }

  .area:hover .area-title,
  .area:focus-visible .area-title {
    color: var(--steel);
    transform: translateX(6px);
  }

  @media (min-width: 800px) {
    .area {
      grid-template-columns: 18rem 1fr;
      align-items: baseline;
    }
  }
</style>
