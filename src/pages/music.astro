---
import Layout from '../layouts/Layout.astro';
import Staff from '../components/Staff.astro';
import Closing from '../components/Closing.astro';
import YouTube from '../components/YouTube.astro';

type Work = {
  title: string;
  subtitle?: string;
  voicing: string;
  details: string;
  publisher: string;
  catalog?: string;
  url: string;
  videoUrl?: string;
};

const works: Work[] = [
  {
    title: 'He Came All So Still',
    voicing: 'SATB divisi, a cappella',
    details: 'A Christmas motet written for the Manhattan Chorale.',
    publisher: 'Gentry Publications',
    catalog: 'JG2538',
    url: 'https://www.gentrypublications.com/product/he-came-all-so-still-satb/',
  },
  {
    title: 'Lux Brumalis',
    subtitle: "Wint'ry Light",
    voicing: 'SATB with semi-improvised piano or string quartet',
    details:
      'A multi-movement winter work (about 9 minutes) on my own text, written for the St. Charles Singers.',
    publisher: 'Walton Music',
    catalog: 'WW1913',
    url: 'https://giamusic.com/resource/lux-brumalis-print-ww1913',
    videoUrl: 'https://www.youtube.com/watch?v=8FUHC_xR0aM',
  },
  {
    title: "Black Is the Color of My True Love's Hair",
    voicing: 'SSAA',
    details: 'An arrangement of the traditional folk song for treble choir.',
    publisher: 'Walton Music',
    catalog: 'WW1760',
    url: 'https://giamusic.com/resource/black-is-the-color-of-my-true-loves-hair-print-ww1760',
  },
];

const home = new URL('/', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': works.map((w) => ({
    '@type': 'MusicComposition',
    name: w.subtitle ? `${w.title} (${w.subtitle})` : w.title,
    composer: { '@type': 'Person', name: 'Nathaniel Adams', url: home },
    publisher: { '@type': 'Organization', name: w.publisher },
    ...(w.catalog && { identifier: w.catalog }),
    url: w.url,
    ...(w.videoUrl && { recordedAs: { '@type': 'MusicRecording', url: w.videoUrl } }),
  })),
};
---
<Layout
  title="Nathaniel Adams | Choral Composer"
  description="Choral music by NYC composer Nathaniel Adams, published by Walton Music and Gentry Publications: He Came All So Still (SATB), Lux Brumalis (SATB and piano), and Black Is the Color (SSAA)."
  jsonLd={jsonLd}
>
  <section class="header">
    <Staff />
    <div class="wrap header-inner">
      <h1 class="display origin rise">Music</h1>
      <p class="lede rise rise-2">
        I write music for choirs and voices. I also sing professionally, including regular concert
        performances at Lincoln Center and Carnegie Hall.
      </p>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="works">
    <h2 id="works" class="origin h2">Published works</h2>
    <div class="works">
      {works.map((w) => (
        <article class="grid work">
          <div class="lead">
            <h3 class="work-title">{w.title}</h3>
            {w.subtitle && <p class="work-sub">{w.subtitle}</p>}
            <p class="work-details">{w.details}</p>
          </div>
          <div class="rail work-meta">
            <p>{w.voicing}</p>
            <p class="muted">{w.publisher}{w.catalog && `, ${w.catalog}`}</p>
            <p class="links">
              <a href={w.url} target="_blank" rel="noopener noreferrer">View the score</a>
              {w.videoUrl && <a href="#performance">Watch a performance</a>}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap block" id="performance" aria-labelledby="perf-title">
    <h2 id="perf-title" class="origin h2">Lux Brumalis, performed by the Missouri State Chorale</h2>
    <div class="video">
      <YouTube id="8FUHC_xR0aM" title="Lux Brumalis, performed by the Missouri State Chorale" />
    </div>
  </section>

  <Closing
    title="Commissions and perusal scores"
    text="For new work, perusal copies, or performance questions, email me. More recordings are on SoundCloud."
    href="mailto:nathanielbadams@gmail.com?subject=Music%20inquiry"
  />
</Layout>

<style>
  .work {
    border-top: 2px solid var(--ink);
    padding: 1.4rem 0 2.25rem;
    row-gap: 1.25rem;
  }

  .work:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .work-title {
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .work-sub {
    margin-top: 0.4rem;
    font: 400 1.25rem/1.3 var(--head);
    color: var(--muted);
  }

  .work-details {
    margin-top: 1rem;
    max-width: 34rem;
  }

  .work-meta {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .work-meta .links {
    margin-top: 0.6rem;
  }

  .video {
    max-width: 56rem;
  }
</style>
