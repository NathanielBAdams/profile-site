---
import Layout from '../layouts/Layout.astro';
import Staff from '../components/Staff.astro';
import Closing from '../components/Closing.astro';
import YouTube from '../components/YouTube.astro';
import SoundCloud from '../components/SoundCloud.astro';
import Linked from '../components/Linked.astro';
import Traced from '../components/Traced.astro';
import conductingOutline from '../data/outlines/nate-adams-conducting.json';
import hmmOutline from '../data/outlines/his-majestys-men-chicago-2023.json';

const bio =
  'Nathaniel Adams is a New York-based vocalist equally comfortable in classical and jazz idioms. He performs regularly with ensembles including the Saint Thomas Choir of Men and Boys, the New York Philharmonic, Musica Sacra, and Clarion Music Society. In addition to his performance career, Nathaniel is a commissioned and published composer whose choral works have been performed across the U.S. and internationally in venues ranging from Lincoln Center to choral festivals in Colombia and China. He is a Resident Composer with the St. Charles Singers and has had works premiered by leading American choirs and vocal ensembles.';

type Work = {
  title: string;
  subtitle?: string;
  voicing: string;
  details?: string;
  ensemble?: string; // who it was written for or recorded by, shown as is
  publisher?: string;
  catalog?: string;
  url?: string; // the score
  videoUrl?: string;
  listen?: string; // a SoundCloud track or set
  set?: boolean; // true when `listen` is a set
};

const works: Work[] = [
  {
    title: 'He Came All So Still',
    voicing: 'SATB divisi, a cappella',
    details: 'A Christmas motet written for the Manhattan Chorale.',
    publisher: 'Gentry Publications',
    catalog: 'JG2538',
    url: 'https://www.gentrypublications.com/product/he-came-all-so-still-satb/',
    listen: 'https://soundcloud.com/nathanielbadams/he-came-all-so-still',
  },
  {
    title: 'Lux Brumalis',
    subtitle: "Wint'ry Light",
    voicing: 'SATB with semi-improvised piano or string quartet',
    details:
      'A multi-movement winter work (about 9 minutes) on my own text, written for the St. Charles Singers.',
    publisher: 'Walton Music',
    catalog: 'WW1913',
    url: 'https://giamusic.com/resource/lux-brumalis-print-ww1913',
    videoUrl: 'https://www.youtube.com/watch?v=8FUHC_xR0aM',
    listen: 'https://soundcloud.com/nathanielbadams/sets/lux-brumalis',
    set: true,
  },
  {
    title: "Black Is the Color of My True Love's Hair",
    voicing: 'SSAA',
    details: 'An arrangement of the traditional folk song for treble choir.',
    publisher: 'Walton Music',
    catalog: 'WW1760',
    url: 'https://giamusic.com/resource/black-is-the-color-of-my-true-loves-hair-print-ww1760',
    listen: 'https://soundcloud.com/nathanielbadams/black-is-the-color',
  },
];

const unpublished: Work[] = [
  {
    title: 'Luces in Rota',
    voicing: 'AATBB',
    ensemble: "His Majesty's Men",
    listen: 'https://soundcloud.com/nathanielbadams/luces-in-rota',
  },
  {
    title: 'Preces and Responses',
    voicing: 'SATB',
    details: 'Settings of the preces and responses for Evensong.',
    ensemble: "Saint Paul's Evensong Choir, Carroll Gardens, Brooklyn",
    listen: 'https://soundcloud.com/nathanielbadams/preces-and-responses-satb',
  },
  {
    title: 'Set Me as a Seal',
    voicing: 'SATB',
    details: 'Written for my wedding.',
    listen: 'https://soundcloud.com/nathanielbadams/set-me-as-a-seal',
  },
  {
    title: 'What Songs Were Sung',
    voicing: 'SATB divisi',
    ensemble: 'St. Charles Singers',
    listen: 'https://soundcloud.com/nathanielbadams/what-songs-were-sung',
  },
];

const lists = [
  { id: 'works', heading: 'Published works', works },
  { id: 'unpublished', heading: 'Unpublished works', works: unpublished },
];

const home = new URL('/', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...works, ...unpublished].map((w) => {
    const recordings = [w.videoUrl, w.listen].filter(Boolean).map((url) => ({ '@type': 'MusicRecording', url }));
    return {
      '@type': 'MusicComposition',
      name: w.subtitle ? `${w.title} (${w.subtitle})` : w.title,
      composer: { '@type': 'Person', name: 'Nathaniel Adams', url: home },
      ...(w.publisher && { publisher: { '@type': 'Organization', name: w.publisher } }),
      ...(w.catalog && { identifier: w.catalog }),
      ...(w.url && { url: w.url }),
      ...(recordings.length && { recordedAs: recordings }),
    };
  }),
};
---
<script>
  document.addEventListener('astro:page-load', () => {
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      const text = document.getElementById(btn.dataset.copy!)?.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select the text to copy';
      }
      setTimeout(() => (btn.textContent = 'Copy bio'), 1800);
    });
  }
  });
</script>

<Layout
  title="Nathaniel Adams | Choral Composer"
  description="Choral music by NYC composer Nathaniel Adams, published by Walton Music and Gentry Publications: He Came All So Still (SATB), Lux Brumalis (SATB and piano), and Black Is the Color (SSAA)."
  jsonLd={jsonLd}
>
  <section class="header">
    <Staff />
    <div class="wrap header-inner">
      <h1 class="display origin staffed rise"><span data-page-title>Music</span></h1>
      <p class="lede staffed rise rise-2">
        I write music for choirs and voices, and I sing professionally in New York.
      </p>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="bio-title">
    <h2 id="bio-title" class="origin h2">Bio</h2>
    <div class="grid bio">
      <p class="lead bio-text" id="bio-text"><Linked text={bio} /></p>
      <div class="rail">
        <p class="muted bio-note">For programs and press.</p>
        <button class="bio-copy" type="button" data-copy="bio-text">Copy bio</button>
      </div>
    </div>
  </section>

  {lists.map((list) => (
    <section class="wrap block" aria-labelledby={list.id}>
      <h2 id={list.id} class="origin h2">{list.heading}</h2>
      <div class="works">
        {list.works.map((w) => (
          <article class="grid work">
            <div class="lead">
              <h3 class="work-title">{w.title}</h3>
              {w.subtitle && <p class="work-sub">{w.subtitle}</p>}
              {w.details && <p class="work-details"><Linked text={w.details} /></p>}
              {w.listen && (
                <div class="work-listen">
                  <SoundCloud url={w.listen} title={w.title} set={w.set} />
                </div>
              )}
            </div>
            <div class="rail work-meta">
              <p>{w.voicing}</p>
              {w.ensemble && <p class="muted"><Linked text={w.ensemble} /></p>}
              {w.publisher && <p class="muted">{w.publisher}{w.catalog && `, ${w.catalog}`}</p>}
              {(w.url || w.videoUrl) && (
                <p class="links">
                  {w.url && <a href={w.url} target="_blank" rel="noopener noreferrer">View the score</a>}
                  {w.videoUrl && <a href="#performance">Watch a performance</a>}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="wrap block" id="performance" aria-labelledby="perf-title">
    <h2 id="perf-title" class="origin h2">Lux Brumalis, performed by the Missouri State Chorale</h2>
    <div class="video">
      <YouTube id="8FUHC_xR0aM" title="Lux Brumalis, performed by the Missouri State Chorale" />
    </div>
  </section>

  <section class="wrap">
    <!-- Equal heights: column widths follow each photo's width-to-height ratio. -->
    <div class="photos" style="--cols: 18fr 15fr">
      <figure>
        <Traced outline={conductingOutline} alt="Nate Adams, seen from behind, conducting a small vocal ensemble at a recording session in a Brooklyn church, with microphones on stands and an Advent wreath in the foreground" />
        <figcaption>Conducting a recording session of one of my pieces, Brooklyn, 2023.</figcaption>
      </figure>
      <figure>
        <Traced outline={hmmOutline} alt="Nate Adams, second from left in glasses, singing with His Majesty's Men, five men in black shirts at music stands in front of a gilded church altar in Chicago, the audience in the foreground" label />
        <figcaption>Singing with <Linked text="His Majesty's Men" />, Chicago, August 2023.</figcaption>
      </figure>
    </div>
  </section>

  <Closing
    title="Commissions and perusal scores"
    text="For new work, perusal copies, or performance questions, email me. More recordings are on SoundCloud."
    href="mailto:nathanielbadams@gmail.com?subject=Music%20inquiry"
  />
</Layout>

<style>
  .work {
    border-top: 2px solid var(--ink);
    padding: 1.4rem 0 2.25rem;
    row-gap: 1.25rem;
  }

  .work:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .work-title {
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .work-sub {
    margin-top: 0.4rem;
    font: 400 1.25rem/1.3 var(--head);
    color: var(--muted);
  }

  .work-details {
    margin-top: 1rem;
    max-width: 34rem;
  }

  .work-listen {
    margin-top: 2.25rem;
  }

  .work-meta {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .work-meta .links {
    margin-top: 0.6rem;
  }

  .video {
    max-width: 56rem;
  }

  .bio {
    row-gap: 1.25rem;
  }

  .bio-text {
    max-width: 40rem;
    font: 400 clamp(1.1rem, 1.6vw, 1.3rem)/1.55 var(--head);
  }

  .bio-note {
    margin-bottom: 0.6rem;
  }

  .bio-copy {
    font: 600 0.9rem/1 var(--head);
    padding: 0.6rem 0.9rem;
    color: var(--ink);
    background: transparent;
    border: 1.5px solid var(--ink);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .bio-copy:hover,
  .bio-copy:focus-visible {
    color: var(--verm);
    border-color: var(--verm);
  }
</style>
