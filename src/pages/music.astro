---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';

type Work = {
  title: string;
  subtitle?: string;
  voicing: string;
  details: string;
  publisher: string;
  catalog?: string;
  url: string;
  videoUrl?: string;
};

const works: Work[] = [
  {
    title: 'He Came All So Still',
    voicing: 'SATB divisi, a cappella',
    details: 'A Christmas motet written for the Manhattan Chorale.',
    publisher: 'Gentry Publications',
    catalog: 'JG2538',
    url: 'https://www.gentrypublications.com/product/he-came-all-so-still-satb/',
  },
  {
    title: 'Lux Brumalis',
    subtitle: "Wint'ry Light",
    voicing: 'SATB with semi-improvised piano or string quartet',
    details:
      'A multi-movement winter work (about 9 minutes) on my own text, written for the St. Charles Singers.',
    publisher: 'Walton Music',
    catalog: 'WW1913',
    url: 'https://giamusic.com/resource/lux-brumalis-print-ww1913',
    videoUrl: 'https://www.youtube.com/watch?v=8FUHC_xR0aM',
  },
  {
    title: "Black Is the Color of My True Love's Hair",
    voicing: 'SSAA',
    details: 'An arrangement of the traditional folk song for treble choir.',
    publisher: 'Walton Music',
    catalog: 'WW1760',
    url: 'https://giamusic.com/resource/black-is-the-color-of-my-true-loves-hair-print-ww1760',
  },
];

const soundcloud = 'https://soundcloud.com/nathanielbadams';
const home = new URL('/', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': works.map((w) => ({
    '@type': 'MusicComposition',
    name: w.subtitle ? `${w.title} (${w.subtitle})` : w.title,
    composer: { '@type': 'Person', name: 'Nathaniel Adams', url: home },
    publisher: { '@type': 'Organization', name: w.publisher },
    ...(w.catalog && { identifier: w.catalog }),
    url: w.url,
    ...(w.videoUrl && { recordedAs: { '@type': 'MusicRecording', url: w.videoUrl } }),
  })),
};
const luxVideo = 'https://www.youtube.com/watch?v=8FUHC_xR0aM';
const luxThumb = 'https://i.ytimg.com/vi/8FUHC_xR0aM/hqdefault.jpg';
---
<Layout
  title="Nathaniel Adams | Choral Composer"
  description="Choral music by NYC composer Nathaniel Adams, published by Walton Music and Gentry Publications: He Came All So Still (SATB), Lux Brumalis (SATB and piano), and Black Is the Color (SSAA)."
  jsonLd={jsonLd}
>
  <section class="page header">
    <h1 class="display">Music</h1>
    <p class="lede">
      I write music for choirs and voices. I also sing professionally, including regular
      concert performances at Lincoln Center and Carnegie Hall.
    </p>
  </section>

  <section class="page rows" aria-label="Published works">
    {works.map((w) => (
      <article class="row">
        <h2 class="row-label">
          {w.title}
          {w.subtitle && <span class="row-sub">{w.subtitle}</span>}
        </h2>
        <div class="row-body">
          <p class="muted">{w.voicing}. {w.publisher}{w.catalog && `, ${w.catalog}`}.</p>
          <p>{w.details}</p>
          <p class="links">
            <a href={w.url} target="_blank" rel="noopener noreferrer">View the score</a>
            {w.videoUrl && <a href={w.videoUrl} target="_blank" rel="noopener noreferrer">Watch a performance</a>}
          </p>
        </div>
      </article>
    ))}
  </section>

  <section class="page video">
    <a class="video-link" href={luxVideo} target="_blank" rel="noopener noreferrer">
      <Frame>
        <img src={luxThumb} alt="The Missouri State Chorale performing Lux Brumalis" width="480" height="360" loading="lazy" />
      </Frame>
      <span class="video-caption">Lux Brumalis, performed by the Missouri State Chorale</span>
    </a>
  </section>

  <section class="page closing">
    <h2 class="closing-title">Commissions and perusal scores</h2>
    <p>
      For new work, perusal copies, or performance questions, email me.
      More recordings are on <a href="https://soundcloud.com/nathanielbadams" target="_blank" rel="noopener noreferrer">SoundCloud</a>.
    </p>
    <a class="button" href="mailto:nathanielbadams@gmail.com?subject=Music%20inquiry">Email nathanielbadams@gmail.com</a>
  </section>
</Layout>

<style>
  .video {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .video-link {
    display: inline-block;
    text-decoration: none;
    width: min(34rem, 100%);
  }

  .video-link img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .video-caption {
    display: block;
    margin-top: 0.6rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
