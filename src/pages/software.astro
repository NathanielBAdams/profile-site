---
import Layout from '../layouts/Layout.astro';
import Staff from '../components/Staff.astro';
---
<Layout
  title="Nate Adams | Software Engineer, Front End and Design"
  description="Nate Adams is a software engineer at Datadog, working across front-end engineering and product design on AI-assisted workflows for Cloud SIEM. Previously at CLEAR."
>
  <section class="header">
    <Staff />
    <div class="wrap header-inner">
      <h1 class="display origin staffed rise" data-page-title>Software</h1>
      <p class="lede staffed rise rise-2">
        I work where front-end engineering meets product design, currently on AI-assisted
        workflows.
      </p>
    </div>
  </section>

  <section class="wrap grid block rows">
    <div class="lead">
      <table class="table">
        <tbody>
          <tr>
            <td>Now</td>
            <td>
              At <a href="https://www.datadoghq.com/" target="_blank" rel="noopener noreferrer">Datadog</a>,
              working on Cloud SIEM
            </td>
          </tr>
          <tr>
            <td>Before</td>
            <td>
              At <a href="https://www.clearme.com/" target="_blank" rel="noopener noreferrer">CLEAR</a>,
              2021 to 2025, where I helped start its design system
            </td>
          </tr>
          <tr>
            <td>Focus</td>
            <td>Front-end engineering, product design, design systems, and AI-assisted workflows</td>
          </tr>
          <tr>
            <td>Elsewhere</td>
            <td><a href="https://www.linkedin.com/in/adamsnathaniel/" target="_blank" rel="noopener noreferrer">Full history on LinkedIn</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<style>
  .rows {
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .rows .table tr:first-child td {
    border-top: 2px solid var(--ink);
  }
</style>
