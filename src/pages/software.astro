---
import Layout from '../layouts/Layout.astro';
import Staff from '../components/Staff.astro';
---
<Layout
  title="Nate Adams | Software Engineering"
  description="Nate Adams works on front-end engineering and product design at Datadog, building AI-assisted workflows for Cloud SIEM."
>
  <section class="header">
    <Staff />
    <div class="wrap header-inner">
      <h1 class="display origin staffed rise"><span data-page-title>Software</span></h1>
      <p class="lede staffed rise rise-2">
        I work on front-end engineering and product design, currently focused on AI-assisted
        workflows.
      </p>
    </div>
  </section>

  <section class="wrap grid block rows">
    <div class="lead">
      <table class="table">
        <tbody>
          <tr>
            <td>Now</td>
            <td>
              At <a href="https://www.datadoghq.com/" target="_blank" rel="noopener noreferrer">Datadog</a>,
              working on Cloud SIEM
            </td>
          </tr>
          <tr>
            <td>Focus</td>
            <td>Front-end engineering, product design, and AI-assisted workflows</td>
          </tr>
          <tr>
            <td>Elsewhere</td>
            <td><a href="https://www.linkedin.com/in/adamsnathaniel/" target="_blank" rel="noopener noreferrer">LinkedIn</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<style>
  .rows {
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .rows .table tr:first-child td {
    border-top: 2px solid var(--ink);
  }
</style>
