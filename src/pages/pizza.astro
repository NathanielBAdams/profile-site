---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Slideshow from '../components/Slideshow';
import { getImage } from 'astro:assets';
import pizza1 from '../assets/pizza_1.jpeg';
import pizza2 from '../assets/pizza_2.jpeg';
import pizza3 from '../assets/pizza_3.jpeg';

const photos = [
  { src: pizza1, alt: 'Homemade pizza topped with sausage and herbs, sliced on a wooden board' },
  { src: pizza2, alt: 'Square pan pizza with mushrooms, green peppers, and tomatoes on a metal peel' },
  { src: pizza3, alt: 'Two homemade pizzas, one pepperoni and one with basil, cooling on wire racks' },
];

const images = await Promise.all(
  photos.map(async ({ src, alt }) => {
    const img = await getImage({ src, width: 960, format: 'webp' });
    return { src: img.src, alt };
  }),
);
---
<Layout
  title="Pizza — Nate Adams"
  description="A weekly ritual: Nate Adams makes pizza from scratch every Sunday."
>
  <Section>
    <div class="container">
      <div class="text">
        <h1 class="heading">Pizza</h1>
        <p class="paragraph">
          Every Sunday, I make pizza from scratch. What started as a Covid exploration
          has become a little ritual that blends creativity, fermentation, and carbs. Here's a taste:
        </p>
      </div>

      <div class="slideshow">
        <Slideshow images={images} client:load />
      </div>
    </div>
  </Section>
</Layout>

<style>
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  .text {
    max-width: 600px;
  }

  .heading {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .paragraph {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .slideshow {
    max-width: 480px;
    width: 100%;
  }
</style>
