---
import Layout from '../layouts/Layout.astro';
import Staff from '../components/Staff.astro';
import Closing from '../components/Closing.astro';
import YouTube from '../components/YouTube.astro';
import SoundCloud from '../components/SoundCloud.astro';
import Linked from '../components/Linked.astro';
import Traced from '../components/Traced.astro';
import conductingOutline from '../data/outlines/nate-adams-conducting.json';

type Work = {
  title: string;
  subtitle?: string;
  voicing: string;
  details?: string;
  ensemble?: string; // who it was written for or recorded by, shown as is
  publisher?: string;
  catalog?: string;
  url?: string; // the score
  video?: { id: string; by: string }; // a YouTube performance
  listen?: string; // a SoundCloud track or set
  set?: boolean; // true when `listen` is a set
};

const works: Work[] = [
  {
    title: 'Lux Brumalis',
    subtitle: "Wint'ry Light",
    voicing: 'SATB with semi-improvised piano or string quartet',
    details:
      'A multi-movement winter work (about 9 minutes) on my own text, written for the St. Charles Singers.',
    publisher: 'Walton Music',
    catalog: 'WW1913',
    url: 'https://giamusic.com/resource/lux-brumalis-print-ww1913',
    video: { id: '8FUHC_xR0aM', by: 'the Missouri State Chorale' },
    listen: 'https://soundcloud.com/nathanielbadams/sets/lux-brumalis',
    set: true,
  },
  {
    title: 'He Came All So Still',
    voicing: 'SATB divisi, a cappella',
    details: 'A Christmas motet written for the Manhattan Chorale.',
    publisher: 'Gentry Publications',
    catalog: 'JG2538',
    url: 'https://www.gentrypublications.com/product/he-came-all-so-still-satb/',
    video: { id: '7sHSngk_I1g', by: 'the Manhattan Chorale' },
    listen: 'https://soundcloud.com/nathanielbadams/he-came-all-so-still',
  },
  {
    title: "Black Is the Color of My True Love's Hair",
    voicing: 'SSAA',
    details: 'An arrangement of the traditional folk song for treble choir.',
    publisher: 'Walton Music',
    catalog: 'WW1760',
    url: 'https://giamusic.com/resource/black-is-the-color-of-my-true-loves-hair-print-ww1760',
    listen: 'https://soundcloud.com/nathanielbadams/black-is-the-color',
  },
];

const unpublished: Work[] = [
  {
    title: 'Luces in Rota',
    voicing: 'AATBB',
    ensemble: "His Majesty's Men",
    listen: 'https://soundcloud.com/nathanielbadams/luces-in-rota',
  },
  {
    title: 'Preces and Responses',
    voicing: 'SATB',
    details: 'Settings of the preces and responses for Evensong.',
    ensemble: "Saint Paul's Evensong Choir, Carroll Gardens, Brooklyn",
    listen: 'https://soundcloud.com/nathanielbadams/preces-and-responses-satb',
  },
  {
    title: 'Set Me as a Seal',
    voicing: 'SATB',
    details: 'Written for my wedding.',
    listen: 'https://soundcloud.com/nathanielbadams/set-me-as-a-seal',
  },
  {
    title: 'What Songs Were Sung',
    voicing: 'SATB divisi',
    ensemble: 'St. Charles Singers',
    listen: 'https://soundcloud.com/nathanielbadams/what-songs-were-sung',
  },
];

const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const videos = works.filter((w) => w.video);

const lists = [
  { id: 'works', heading: 'Published works', works },
  { id: 'unpublished', heading: 'Unpublished works', works: unpublished },
];

const home = new URL('/', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...works, ...unpublished].map((w) => {
    const recordings = [w.video && `https://www.youtube.com/watch?v=${w.video.id}`, w.listen].filter(Boolean).map((url) => ({ '@type': 'MusicRecording', url }));
    return {
      '@type': 'MusicComposition',
      name: w.subtitle ? `${w.title} (${w.subtitle})` : w.title,
      composer: { '@type': 'Person', name: 'Nathaniel Adams', url: home },
      ...(w.publisher && { publisher: { '@type': 'Organization', name: w.publisher } }),
      ...(w.catalog && { identifier: w.catalog }),
      ...(w.url && { url: w.url }),
      ...(recordings.length && { recordedAs: recordings }),
    };
  }),
};
---

<script>
  // "Watch the performance" glides down to its video instead of jumping,
  // then readies the play button for the keyboard.
  document.addEventListener('astro:page-load', () => {
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-smooth]')) {
      a.addEventListener('click', (e) => {
        const target = document.querySelector<HTMLElement>(a.hash);
        if (!target) return;
        e.preventDefault();
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(history.state, '', a.hash);
        target.querySelector<HTMLElement>('.yt-play')?.focus({ preventScroll: true });
      });
    }
  });
</script>

<Layout
  title="Nathaniel Adams | Choral Composer"
  description="Choral music by NYC composer Nathaniel Adams, published by Walton Music and Gentry Publications: He Came All So Still (SATB), Lux Brumalis (SATB and piano), and Black Is the Color (SSAA)."
  jsonLd={jsonLd}
>
  <section class="header">
    <Staff />
    <div class="wrap header-inner">
      <h1 class="display origin staffed rise" data-page-title>Composition</h1>
      <p class="lede staffed rise rise-2">
        I write music for choirs and voices, published by Walton Music and Gentry Publications.
      </p>
    </div>
  </section>

  <Traced outline={conductingOutline} alt="Nate Adams, seen from behind, conducting a recording session of one of his pieces in a Brooklyn church, 2023, with a small vocal ensemble, microphones on stands, and an Advent wreath in the foreground" cover top label lazy={false} />

  {lists.map((list) => (
    <section class="wrap block" aria-labelledby={list.id}>
      <h2 id={list.id} class="origin h2">{list.heading}</h2>
      <div class="works">
        {list.works.map((w) => (
          <article class="grid work">
            <div class="lead">
              <h3 class="work-title">{w.title}</h3>
              {w.subtitle && <p class="work-sub">{w.subtitle}</p>}
              {w.details && <p class="work-details"><Linked text={w.details} /></p>}
              {(w.listen || w.video) && (
                <div class="work-listen">
                  {w.listen && <SoundCloud url={w.listen} title={w.title} set={w.set} />}
                  {w.video && (
                    <a class="watch" href={`#video-${slug(w.title)}`} data-smooth>
                      <span class="watch-thumb">
                        <img src={`https://i.ytimg.com/vi/${w.video.id}/mqdefault.jpg`} alt="" width="320" height="180" loading="lazy" />
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11.25" /><path d="M10 7.5l6.5 4.5-6.5 4.5z" /></svg>
                      </span>
                      <span class="watch-text">
                        <span class="watch-label">Watch the performance</span>
                        <span class="watch-by">{w.video.by.replace(/^the /, '')}</span>
                      </span>
                    </a>
                  )}
                </div>
              )}
            </div>
            <div class="rail work-meta">
              <p>{w.voicing}</p>
              {w.ensemble && <p class="muted"><Linked text={w.ensemble} /></p>}
              {w.publisher && <p class="muted">{w.publisher}{w.catalog && `, ${w.catalog}`}</p>}
              {w.url && (
                <p class="links">
                  <a href={w.url} target="_blank" rel="noopener noreferrer">View the score</a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  {videos.map((w) => (
    <section class="wrap block video-block" id={`video-${slug(w.title)}`} aria-labelledby={`video-${slug(w.title)}-title`}>
      <h2 id={`video-${slug(w.title)}-title`} class="origin h2">{w.title}, performed by {w.video!.by}</h2>
      <div class="video">
        <YouTube id={w.video!.id} title={`${w.title}, performed by ${w.video!.by}`} />
      </div>
    </section>
  ))}

  <Closing
    title="Commissions and perusal scores"
    text="For new work, perusal copies, or performance questions, email me. More recordings are on SoundCloud."
    href="mailto:nathanielbadams@gmail.com?subject=Composition%20inquiry"
  />
</Layout>

<style>
  .work {
    border-top: 2px solid var(--ink);
    padding: 1.4rem 0 2.25rem;
    row-gap: 1.25rem;
  }

  .work:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .work-title {
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .work-sub {
    margin-top: 0.4rem;
    font: 400 1.25rem/1.3 var(--head);
    color: var(--muted);
  }

  .work-details {
    margin-top: 1rem;
    max-width: 34rem;
  }

  .work-listen {
    margin-top: 2.25rem;
  }

  .work-meta {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .work-meta .links {
    margin-top: 0.6rem;
  }

  .video {
    max-width: 56rem;
  }

  .video-block {
    scroll-margin-top: 5rem;
  }

  .work-listen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
  }

  /* A small still of the video that leads down to it: gray until hovered,
     like the photos. */
  .watch {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink);
    text-decoration: none;
  }

  .watch-thumb {
    position: relative;
    display: block;
    width: 7.5rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
    outline: 1.5px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.25s ease;
  }

  .watch-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter 0.35s ease, transform 0.6s var(--ease);
  }

  .watch-thumb svg {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.9rem;
    height: 1.9rem;
    translate: -50% -50%;
  }

  .watch-thumb circle {
    fill: var(--verm);
  }

  .watch-thumb path {
    fill: var(--paper);
  }

  .watch-text {
    display: grid;
    gap: 0.3rem;
  }

  .watch-label {
    font: 600 1.05rem/1 var(--head);
    transition: color 0.2s ease;
  }

  .watch-by {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.2;
  }

  .watch:hover .watch-thumb,
  .watch:focus-visible .watch-thumb {
    outline-color: var(--verm);
  }

  .watch:hover img,
  .watch:focus-visible img {
    filter: none;
    transform: scale(1.06);
  }

  .watch:hover .watch-label {
    color: var(--verm);
  }

  @media (prefers-reduced-motion: reduce) {
    .watch:hover img {
      transform: none;
    }
  }
</style>
