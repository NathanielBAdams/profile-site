---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="page footer-inner">
    <a href="mailto:nathanielbadams@gmail.com">nathanielbadams@gmail.com</a>
    <nav class="footer-links" aria-label="Elsewhere">
      <a href="https://soundcloud.com/nathanielbadams" target="_blank" rel="noopener noreferrer">SoundCloud</a>
      <a href="https://www.linkedin.com/in/adamsnathaniel/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
    <span class="footer-meta">Nate Adams, New York City, {year}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--ice);
    font-size: 0.94rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: baseline;
    padding-top: 1.75rem;
    padding-bottom: 2.25rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-meta {
    color: var(--slate);
    margin-left: auto;
  }
</style>
