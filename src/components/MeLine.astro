---
// A single vermilion pen stroke that circles some text and flows to a photo,
// then retracts. Two uses, on every page:
// - Hover (or tap) Nate in a traced photo: it circles his name (the big Home
//   title when it's on screen, otherwise the name in the sticky nav) and
//   lands on him.
// - Hover (or tap) a credit marked data-shows="<id>": it circles the credit
//   and lands on the photo marked data-photo="<id>", which gets a vermilion
//   frame. Credits whose photo isn't on the page do nothing, so photos can
//   be added, swapped or removed by changing those attributes alone.
---
<svg class="me-line" aria-hidden="true" transition:persist="me-line">
  <path />
  <circle r="3" />
</svg>

<style>
  .me-line {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 30;
    pointer-events: none;
    overflow: visible;
  }

  path {
    fill: none;
    stroke: var(--verm);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  circle {
    fill: var(--verm);
    opacity: 0;
  }

  /* A photo a credit is pointing at gets a thin vermilion frame. */
  /* On the photo's wrapper, not the image, so the grayscale filter on the
     image doesn't gray out the frame. */
  :global([data-photo] > :first-child) {
    outline: 1.5px solid transparent;
    outline-offset: 5px;
    transition: outline-color 0.3s ease;
  }

  :global([data-photo].is-linked > :first-child) {
    outline-color: var(--verm);
  }

  /* Credits with a photo on the page turn vermilion while pointed at it. */
  :global(.shows-photo) {
    cursor: pointer;
    transition: color 0.2s ease;
  }

  :global(.shows-photo:hover) {
    color: var(--verm);
  }
</style>

<script>
  const svg = document.querySelector<SVGSVGElement>('svg.me-line')!;
  const line = svg.querySelector('path')!;
  const dot = svg.querySelector('circle')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DRAW = 950; // ms to draw the whole stroke
  const UNDRAW = 380; // ms to retract it

  type Point = { x: number; y: number; label: boolean };
  type Link = {
    key: Element; // what was hovered
    from: () => DOMRect | null; // the text to circle
    to: () => Point; // where the stroke lands
    mark: HTMLElement; // gets a class while the link is shown
    cls: string;
  };
  let link: Link | null = null;
  let p = 0; // progress 0..1
  let dir = 0; // 1 drawing, -1 retracting
  let last = 0;
  let running = false;
  let tapTimer = 0;
  let pinnedUntil = 0; // after a click, keep the link through the scroll

  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  // The text box of an element, not its full block width.
  function textRect(el: Element) {
    const r = document.createRange();
    r.selectNodeContents(el);
    return r.getBoundingClientRect();
  }

  function nameRect() {
    const navBottom = document.querySelector('.nav')?.getBoundingClientRect().bottom ?? 0;
    const title = document.querySelector('[data-me-name="title"]');
    if (title) {
      const r = textRect(title);
      if (r.top >= navBottom && r.bottom <= window.innerHeight) return r;
    }
    const nav = document.querySelector('[data-me-name="nav"]');
    return nav ? textRect(nav) : null;
  }

  // The outline's points, in photo pixels, read once per photo.
  const outlines = new WeakMap<Element, number[][]>();
  function outlinePoints(el: HTMLElement) {
    let pts = outlines.get(el);
    if (!pts) {
      const nums = (el.querySelector('.me-shape')?.getAttribute('d') ?? '').match(/-?[\d.]+/g) ?? [];
      pts = [];
      for (let i = 0; i + 1 < nums.length; i += 2) pts.push([+nums[i], +nums[i + 1]]);
      outlines.set(el, pts);
    }
    return pts;
  }

  // Where the stroke lands: the top of the "Me" label, or just above his
  // head. If that's hidden under the sticky nav or off screen, it lands on
  // the highest part of his outline that's still visible.
  function landing(el: HTMLElement) {
    const top = (document.querySelector('.nav')?.getBoundingClientRect().bottom ?? 0) + 8;
    const label = el.querySelector('.me-label');
    if (label) {
      const r = label.getBoundingClientRect();
      if (r.top >= top) return { x: r.left + r.width / 2, y: r.top, label: true };
    }
    const s = el.querySelector('svg')!;
    const m = s.getScreenCTM();
    if (!m) return { x: 0, y: 0, label: false };
    const [hx, hy] = (s.dataset.top ?? '0 0').split(' ').map(Number);
    const head = new DOMPoint(hx, hy).matrixTransform(m);
    if (head.y - 6 >= top) return { x: head.x, y: head.y - 6, label: false };
    const box = s.getBoundingClientRect();
    let best: DOMPoint | null = null;
    for (const [x, y] of outlinePoints(el)) {
      const q = new DOMPoint(x, y).matrixTransform(m);
      if (q.y < top || q.y > window.innerHeight || q.x < box.left || q.x > box.right) continue;
      if (!best || q.y < best.y) best = q;
    }
    return best ? { x: best.x, y: best.y, label: false } : { x: head.x, y: Math.max(top, head.y), label: false };
  }

  // A credit's stroke lands on the nearest edge of its photo. If the photo
  // is above or below the screen, the stroke runs off that edge toward it.
  function edge(el: HTMLElement, from: DOMRect | null): Point {
    const r = (el.querySelector('img') ?? el).getBoundingClientRect();
    const top = (document.querySelector('.nav')?.getBoundingClientRect().bottom ?? 0) + 8;
    const fy = from ? from.top + from.height / 2 : 0;
    const fx = from ? from.left + from.width / 2 : 0;
    let x = r.left + r.width / 2;
    let y = r.top;
    if (fy > r.bottom) y = r.bottom;
    else if (fy >= r.top) {
      x = fx < r.left ? r.left : r.right;
      y = r.top + r.height / 2;
    }
    x = Math.min(Math.max(x, r.left), r.right);
    if (r.top > window.innerHeight - 24) return { x, y: window.innerHeight + 40, label: true };
    if (r.bottom < top + 24) return { x, y: top - 40, label: true };
    y = Math.min(Math.max(y, Math.max(top, r.top)), Math.min(window.innerHeight - 8, r.bottom));
    return { x, y, label: false };
  }

  // One continuous stroke: a slightly irregular loop around the name, a
  // little more than a full turn, which flows into a curve down to Nate.
  function stroke(a: DOMRect, to: { x: number; y: number }) {
    const cx = a.left + a.width / 2;
    const cy = a.top + a.height / 2;
    const pad = Math.max(7, Math.min(a.height * 0.38, 22));
    const rx = a.width / 2 + pad;
    const ry = a.height / 2 + pad * 0.85;
    const exit = Math.atan2((to.y - cy) / ry, (to.x - cx) / rx);
    const start = exit + 0.45;
    const sweep = -(2 * Math.PI + 0.55);
    const N = 72;
    const pts: [number, number][] = [];
    for (let i = 0; i <= N; i++) {
      const t = i / N;
      const th = start + sweep * t;
      const k = (0.97 + 0.07 * t) * (1 + 0.022 * Math.sin(3 * th + 1.3));
      pts.push([cx + rx * k * Math.cos(th), cy + ry * k * Math.sin(th)]);
    }
    const [ex, ey] = pts[N];
    const [px, py] = pts[N - 1];
    const tl = Math.hypot(ex - px, ey - py) || 1;
    const tan = [(ex - px) / tl, (ey - py) / tl];
    const dist = Math.hypot(to.x - ex, to.y - ey);
    const dx = (to.x - ex) / (dist || 1);
    const dy = (to.y - ey) / (dist || 1);
    const k1 = Math.min(220, dist * 0.35);
    const k2 = Math.min(200, dist * 0.45);
    // Leave the loop along its own direction, bending toward the target;
    // arrive from above (or below, when the target is higher), or from the
    // side when it's level with the text.
    const c1 = [ex + (tan[0] * 0.3 + dx * 0.7) * k1, ey + (tan[1] * 0.3 + dy * 0.7) * k1];
    const ax = -dx * 0.6;
    const ay = dy >= 0 ? -0.8 * dy - 0.2 : -0.8 * dy + 0.2;
    const al = Math.hypot(ax, ay) || 1;
    const c2 = [to.x + (ax / al) * k2, to.y + (ay / al) * k2];
    // Keep the whole stroke on screen.
    c1[1] = Math.max(4, c1[1]);
    c2[1] = Math.max(4, c2[1]);
    const f = (n: number) => n.toFixed(1);
    return (
      'M' + pts.map(([x, y]) => `${f(x)} ${f(y)}`).join(' L') +
      ` C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(to.x)} ${f(to.y)}`
    );
  }

  function render() {
    if (!link) return;
    const a = link.from();
    if (!a) return;
    const to = link.to();
    line.setAttribute('d', stroke(a, to));
    const L = line.getTotalLength();
    const e = ease(p);
    line.style.strokeDasharray = `${L} ${L}`;
    line.style.strokeDashoffset = `${L * (1 - e)}`;
    dot.setAttribute('cx', `${to.x}`);
    dot.setAttribute('cy', `${to.y}`);
    dot.style.opacity = !to.label && e > 0.97 ? '1' : '0';
  }

  function frame(now: number) {
    const dt = now - last;
    last = now;
    if (dir > 0) p = reduce ? 1 : Math.min(1, p + dt / DRAW);
    if (dir < 0) p = reduce ? 0 : Math.max(0, p - dt / UNDRAW);
    render();
    if (dir < 0 && p === 0) {
      line.removeAttribute('d');
      dot.style.opacity = '0';
      link?.mark.classList.remove(link.cls);
      link = null;
      dir = 0;
    }
    // Keep tracking while shown, so the stroke follows scrolling.
    if (link) requestAnimationFrame(frame);
    else running = false;
  }

  function go() {
    if (running) return;
    running = true;
    last = performance.now();
    requestAnimationFrame(frame);
  }

  function show(next: Link) {
    if (link && link.key !== next.key) {
      link.mark.classList.remove(link.cls);
      p = 0;
    }
    link = next;
    link.mark.classList.add(link.cls);
    dir = 1;
    go();
  }

  function hide() {
    if (!link) return;
    dir = -1;
    go();
  }

  // Nate in a photo: circle his name, land on him. The hover reveal is CSS;
  // is-active does the same for a tap.
  function meLink(shape: Element, touch: boolean): Link {
    const el = shape.closest<HTMLElement>('.traced')!;
    return { key: el, from: nameRect, to: () => landing(el), mark: el, cls: touch ? 'is-active' : 'is-hovered' };
  }

  // A credit: circle it, land on its photo, frame the photo.
  const photoFor = (id: string) => document.querySelector<HTMLElement>(`[data-photo~="${CSS.escape(id)}"]`);
  function creditLink(el: HTMLElement): Link | null {
    const target = photoFor(el.dataset.shows ?? '');
    if (!target) return null;
    const text = el.querySelector('[data-shows-text]') ?? el;
    const from = () => textRect(text);
    return { key: el, from, to: () => edge(target, from()), mark: target, cls: 'is-linked' };
  }

  // Mark the credits that have a photo on this page, so only they respond.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-shows]').forEach((el) => {
      if (photoFor(el.dataset.shows ?? '')) el.classList.add('shows-photo');
    });
  });

  // Leaving the page: drop any line at once.
  document.addEventListener('astro:before-swap', () => {
    link = null;
    p = 0;
    dir = 0;
    pinnedUntil = 0;
    clearTimeout(tapTimer);
    line.removeAttribute('d');
    dot.style.opacity = '0';
  });

  const shapeOf = (t: EventTarget | null) =>
    t instanceof Element ? t.closest<SVGPathElement>('.me-shape') : null;
  const creditOf = (t: EventTarget | null) =>
    t instanceof Element ? t.closest<HTMLElement>('.shows-photo') : null;
  const linkFor = (t: EventTarget | null, touch: boolean) => {
    const s = shapeOf(t);
    if (s) return meLink(s, touch);
    const c = creditOf(t);
    return c ? creditLink(c) : null;
  };

  document.addEventListener('pointerover', (e) => {
    if (e.pointerType !== 'mouse' || performance.now() < pinnedUntil) return;
    const next = linkFor(e.target, false);
    if (next) show(next);
  });

  document.addEventListener('pointerout', (e) => {
    if (e.pointerType !== 'mouse' || !link || performance.now() < pinnedUntil) return;
    const from = shapeOf(e.target) ?? creditOf(e.target);
    const to = shapeOf(e.relatedTarget) ?? creditOf(e.relatedTarget);
    if (from && from !== to) hide();
  });

  // Clicking a credit brings its photo into view; the line follows it there.
  document.addEventListener('click', (e) => {
    const c = creditOf(e.target);
    if (!c) return;
    const next = creditLink(c);
    if (!next) return;
    show(next);
    next.mark.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    pinnedUntil = performance.now() + 2600;
    clearTimeout(tapTimer);
    tapTimer = window.setTimeout(() => {
      pinnedUntil = 0;
      if (!c.matches(':hover')) hide();
    }, 2600);
  });

  // Touch: a tap plays it and holds it for a moment.
  document.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'mouse') return;
    clearTimeout(tapTimer);
    const next = linkFor(e.target, true);
    if (!next) return hide();
    show(next);
    tapTimer = window.setTimeout(hide, 2800);
  });
</script>
