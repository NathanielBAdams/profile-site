---
// Faint calibration rings and tick marks, drawn behind hero content.
interface Props { class?: string }
const { class: className } = Astro.props;
const c = 300;
const rings = [70, 130, 190, 250];
const ticks = Array.from({ length: 120 }, (_, i) => {
  const a = (i * 3 * Math.PI) / 180;
  const major = i % 10 === 0;
  const r1 = 276;
  const r2 = major ? 296 : 284;
  return {
    x1: c + r1 * Math.cos(a), y1: c + r1 * Math.sin(a),
    x2: c + r2 * Math.cos(a), y2: c + r2 * Math.sin(a), major,
  };
});
---
<svg class:list={['instrument', className]} viewBox="0 0 600 600" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
    {rings.map((r) => <circle cx={c} cy={c} r={r} />)}
    <line x1="0" y1={c} x2="600" y2={c} />
    <line x1={c} y1="0" x2={c} y2="600" />
    {ticks.map((t) => (
      <line x1={t.x1.toFixed(1)} y1={t.y1.toFixed(1)} x2={t.x2.toFixed(1)} y2={t.y2.toFixed(1)} opacity={t.major ? 1 : 0.6} />
    ))}
  </g>
</svg>

<style>
  .instrument {
    color: var(--ice);
    pointer-events: none;
  }
</style>
