---
// Click-to-load YouTube embed: shows the still, loads the player only on click.
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<div class="yt" data-id={id} data-title={title}>
  <button type="button" class="yt-play" aria-label={`Play video: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" />
    <span class="yt-icon" aria-hidden="true">
      <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="23" /><path d="M19 15l14 9-14 9z" /></svg>
    </span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title ?? 'YouTube video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--carbon);
  }

  .yt :global(iframe),
  .yt-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt-play {
    padding: 0;
    cursor: pointer;
    background: none;
  }

  .yt-play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .yt-icon svg {
    width: 4rem;
    height: 4rem;
    fill: none;
    stroke: #fafbfc;
    stroke-width: 1;
  }

  .yt-icon path {
    fill: #fafbfc;
    stroke: none;
  }

  .yt-play:hover .yt-icon circle {
    fill: rgba(22, 24, 27, 0.35);
  }
</style>
