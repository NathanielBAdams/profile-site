---
// A photo with Nate traced by a faint vermilion silhouette. On hover he
// appears in color against the grayscale photo, outlined in vermilion, with
// an optional "Me" label above his head (for group shots). The outline comes
// from scripts/trace-person.py and lives in the photo's pixel coordinates.
//
// cover: the photo fills a fixed-height band with object-fit: cover; the SVG
// uses the same crop (xMidYMid slice), so the outline stays on him at any size.
interface Outline {
  image: string;
  width: number;
  height: number;
  path: string;
  top: number[];
  bounds?: number[]; // x, y, width, height of his outline
}
// A friend: someone else in the photo who gets their own quieter outline and
// label on hover, in a second color. Just for fun.
interface Friend {
  outline: Outline;
  label: string;
}
interface Props {
  outline: Outline;
  friend?: Friend;
  alt: string;
  label?: boolean;
  cover?: boolean;
  top?: boolean; // with cover: keep the top of the photo instead of the middle
  lazy?: boolean;
  class?: string;
}
const { outline, friend, alt, label = false, cover = false, top: alignTop = false, lazy = true, class: cls } = Astro.props;
const { image: src, width: w, height: h, path, top } = outline;
const id = `me-${src.replace(/\W+/g, '-')}`;
// The middle of his outline, which phone bands zoom in on.
const [bx, by, bw, bh] = outline.bounds ?? [top[0], top[1], 0, 0];
const nx = (bx + bw / 2) / w;
const ny = (by + bh / 2) / h;
---
<div
  class:list={['traced', cover && 'cover', cover && alignTop && 'top', cls]}
  style={`--w: ${w}; --h: ${h}; --tx: ${top[0] / w}; --ty: ${top[1] / h}; --nx: ${nx}; --ny: ${ny};${friend ? ` --fx: ${friend.outline.top[0] / w}; --fy: ${friend.outline.top[1] / h};` : ''}`}
>
  <img
    src={src}
    alt={alt}
    width={w}
    height={h}
    loading={lazy ? 'lazy' : undefined}
    decoding="async"
    onload="this.parentElement.classList.add('ready')"
  />
  <svg
    viewBox={`0 0 ${w} ${h}`}
    preserveAspectRatio={cover ? (alignTop ? 'xMidYMin slice' : 'xMidYMid slice') : 'none'}
    data-top={`${top[0]} ${top[1]}`}
    aria-hidden="true"
  >
    <defs>
      <clipPath id={id}><path d={path} /></clipPath>
      {friend && <clipPath id={`${id}-friend`}><path d={friend.outline.path} /></clipPath>}
    </defs>
    {friend && <image class="friend-color" href={src} width={w} height={h} clip-path={`url(#${id}-friend)`} />}
    {friend && <path class="friend-shape" d={friend.outline.path} />}
    <image class="me-color" href={src} width={w} height={h} clip-path={`url(#${id})`} />
    <path class="me-shape" d={path} />
  </svg>
  {label && <span class="me-label" aria-hidden="true">That’s me</span>}
  {friend && <span class="me-label friend-label" aria-hidden="true">{friend.label}</span>}
</div>

<style>
  .traced {
    position: relative;
    container-type: inline-size;
    /* Rendered photo size and offset, for placing the label. */
    --iw: 100cqw;
    --ih: calc(100cqw * var(--h) / var(--w));
    --ox: 0px;
    --oy: 0px;
  }

  .traced.cover {
    container-type: size;
    height: clamp(16rem, 44vw, 34rem);
    overflow: hidden;
    --iw: max(100cqw, 100cqh * var(--w) / var(--h));
    --ox: calc((100cqw - var(--iw)) / 2);
    --oy: calc((100cqh - var(--ih)) / 2);
  }

  .traced img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.08);
  }

  .traced.cover img {
    height: 100%;
    object-fit: cover;
  }

  .traced.cover.top {
    --oy: 0px;
  }

  .traced.cover.top img {
    object-position: center top;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* No tint until the photo has arrived, so a slow connection never shows a
     pink silhouette on an empty frame. */
  .traced:not(.ready) .me-shape {
    fill: transparent;
  }

  /* Phones: a band would shrink a group photo to a strip of tiny faces, so
     it gets taller and zooms in around Nate instead, keeping him in frame.
     The photo and its outline are placed with the same numbers, so they stay
     lined up. */
  @media (max-width: 833px) {
    .traced.cover {
      height: min(80vw, 26rem);
      --iw: max(155cqw, 100cqh * var(--w) / var(--h));
      --ih: calc(var(--iw) * var(--h) / var(--w));
      --ox: clamp(100cqw - var(--iw), 50cqw - var(--iw) * var(--nx), 0px);
      --oy: clamp(100cqh - var(--ih), 50cqh - var(--ih) * var(--ny), 0px);
    }

    .traced.cover img,
    .traced.cover svg {
      position: absolute;
      left: var(--ox);
      top: var(--oy);
      width: var(--iw);
      height: var(--ih);
      max-width: none;
      object-fit: fill;
    }

    .traced.cover.top {
      --oy: clamp(100cqh - var(--ih), 50cqh - var(--ih) * var(--ny), 0px);
    }

    /* Keep the labels inside the band when his head is near its top. */
    .traced.cover .me-label {
      top: max(calc(var(--oy) + var(--ih) * var(--ty) - 0.6rem), 2.1rem);
    }

    .traced.cover .friend-label {
      top: max(calc(var(--oy) + var(--ih) * var(--fy) - 0.6rem), 2.1rem);
    }
  }


  .me-shape {
    fill: rgb(198 58 43 / 0.2);
    stroke: transparent;
    stroke-width: 2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    pointer-events: visiblePainted;
    transition: fill 0.3s ease, stroke 0.3s ease;
  }

  /* The same photo in color, clipped to Nate. */
  .me-color {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .me-label {
    position: absolute;
    left: calc(var(--ox) + var(--iw) * var(--tx));
    top: calc(var(--oy) + var(--ih) * var(--ty) - 0.6rem);
    translate: -50% calc(-100% + 0.25rem);
    padding: 0.2rem 0.55rem;
    background: var(--verm);
    color: var(--paper);
    font: 600 0.85rem/1.2 var(--head);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease, translate 0.3s var(--ease);
  }

  /* Hovering either person in a photo with a friend shows both. */
  .traced:has(.me-shape:hover) .me-shape,
  .traced:has(.friend-shape:hover) .me-shape,
  .traced.is-active .me-shape {
    fill: transparent;
    stroke: var(--verm);
  }

  .traced:has(.me-shape:hover) .me-color,
  .traced:has(.friend-shape:hover) .me-color,
  .traced.is-active .me-color {
    opacity: 1;
  }

  .traced:has(.me-shape:hover) .me-label:not(.friend-label),
  .traced:has(.friend-shape:hover) .me-label:not(.friend-label),
  .traced.is-active .me-label:not(.friend-label) {
    opacity: 1;
    translate: -50% -100%;
  }

  /* The friend: no tint until hovered, then a thinner outline and a label in
     a deep teal that sits opposite the vermilion. */
  .traced {
    --friend: #2a6f7c;
  }

  .friend-shape {
    fill: transparent;
    stroke: transparent;
    stroke-width: 1.25;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    pointer-events: visiblePainted;
    transition: stroke 0.3s ease;
  }

  .friend-color {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .friend-label {
    left: calc(var(--ox) + var(--iw) * var(--fx));
    top: calc(var(--oy) + var(--ih) * var(--fy) - 0.6rem);
    background: var(--friend);
  }

  .traced:has(.friend-shape:hover) .friend-shape,
  .traced:has(.me-shape:hover) .friend-shape,
  .traced.is-active .friend-shape {
    stroke: var(--friend);
  }

  .traced:has(.friend-shape:hover) .friend-color,
  .traced:has(.me-shape:hover) .friend-color,
  .traced.is-active .friend-color {
    opacity: 1;
  }

  .traced:has(.friend-shape:hover) .friend-label,
  .traced:has(.me-shape:hover) .friend-label,
  .traced.is-active .friend-label {
    opacity: 1;
    translate: -50% -100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .me-shape,
    .me-color,
    .me-label,
    .friend-shape,
    .friend-color {
      transition: none;
    }
  }

  /* Touch screens keep :hover after a tap, which would leave a photo lit
     after scrolling away. There, only the scroll reveal (is-active) shows. */
  @media (hover: none) {
    .traced.traced.ready:not(.is-active) .me-shape {
      fill: rgb(198 58 43 / 0.2);
      stroke: transparent;
    }

    .traced.traced:not(.is-active) .me-color,
    .traced.traced:not(.is-active) .friend-color {
      opacity: 0;
    }

    .traced.traced:not(.is-active) .friend-shape {
      stroke: transparent;
    }

    .traced.traced.traced:not(.is-active) .me-label {
      opacity: 0;
      translate: -50% calc(-100% + 0.25rem);
    }
  }
</style>
