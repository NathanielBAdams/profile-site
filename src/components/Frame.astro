---
// Corner-bracket ticks around an image, like the registration marks on a plate.
// When the frame scrolls into view the brackets close in, like a focus lock.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<div class:list={['frame', className]}>
  <slot />
  <span class="tick tl" aria-hidden="true"></span>
  <span class="tick tr" aria-hidden="true"></span>
  <span class="tick bl" aria-hidden="true"></span>
  <span class="tick br" aria-hidden="true"></span>
</div>

<script>
  const frames = document.querySelectorAll<HTMLElement>('.frame');
  if (document.documentElement.classList.contains('motion') && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('locked');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.3 },
    );
    frames.forEach((f) => io.observe(f));
  } else {
    frames.forEach((f) => f.classList.add('locked'));
  }
</script>

<style>
  .frame {
    position: relative;
    padding: 10px;
  }

  .tick {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--carbon);
    border-style: solid;
    border-width: 0;
    transition:
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.5s ease-out;
  }

  .tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; --dx: -10px; --dy: -10px; }
  .tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; --dx: 10px; --dy: -10px; }
  .bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; --dx: -10px; --dy: 10px; }
  .br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; --dx: 10px; --dy: 10px; }

  :global(.motion) .frame:not(.locked) .tick {
    transform: translate(var(--dx), var(--dy));
    opacity: 0;
  }
</style>
