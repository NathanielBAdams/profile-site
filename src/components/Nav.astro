---
const links = [
  { href: '/choral-contracting/', label: 'Choral contracting' },
  { href: '/music/', label: 'Music' },
  { href: '/software/', label: 'Software' },
];
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="nav-name" href="/">Nate Adams</a>
    <nav class="nav-links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
    position: relative;
    z-index: 2;
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }

  .nav-name {
    font: 700 1.05rem/1 var(--head);
    text-decoration: none;
  }

  .nav-name:hover {
    color: var(--ink);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem clamp(1rem, 3vw, 2.25rem);
    font-size: 0.95rem;
  }

  .nav-links a {
    position: relative;
    text-decoration: none;
    color: var(--muted);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3em;
    height: 2px;
    background: var(--verm);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--ink);
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current='page']::after {
    transform: scaleX(1);
  }
</style>
