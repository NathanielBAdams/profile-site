---
// A playable staff drawn behind a page's opening section. Place it as the
// first child of a positioned container; that container receives the pointer.
// staves=2 draws a grand staff (treble + bass) with clefs; staves=1 draws a
// plain treble staff.
interface Props {
  staves?: 1 | 2;
  center?: number; // vertical center of the staff, as a fraction of the height
}
const { staves = 2, center = 0.56 } = Astro.props;
---
<canvas class="staff" data-staves={staves} data-center={center} aria-hidden="true" transition:persist="staff"></canvas>

<style>
  .staff {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* The host section takes the pointer; see attach(). */
    pointer-events: none;
    /* Between pages the canvas stays live and animates itself (see rehost),
       so the view transition leaves it alone. */
    view-transition-name: staff;
  }

  :global(::view-transition-group(staff)),
  :global(::view-transition-old(staff)),
  :global(::view-transition-new(staff)) {
    animation: none;
  }

  :global(::view-transition-old(staff)) {
    display: none;
  }

  /* Phones: the staff appears on Home only, as a slim band of its own under
     the intro, easy to tap. The other pages open straight into their content
     (the canvas stays, hidden, so a note can ring on across pages). */
  @media (max-width: 833px) {
    :global(.hero:has(> .staff)) {
      display: flex;
      flex-direction: column;
    }

    .staff {
      position: relative;
      order: 2;
      height: 9.5rem;
      margin-bottom: 0.75rem;
      touch-action: pan-y;
    }

    :global(.header) > .staff {
      display: none;
    }
  }

  :global(.on-staff) {
    cursor: none;
  }
</style>

<script>
  // The lines draw in once on load and ripple slightly where the pointer
  // crosses them. A half note follows the pointer, snapped to the nearest line
  // or space; clicking plays that pitch for the length of a half note. Under
  // prefers-reduced-motion the lines are still, but the note and its sound
  // remain, since they only respond to the visitor.
  import { GLYPHS, type GlyphName } from '../scripts/glyphs';
  import { midiOfStep } from '../scripts/pitch';
  import { play, prefetch, prime } from '../scripts/voice';

  type Line = { y: number; d: Float32Array; v: Float32Array };
  type Note = { x: number; y: number; step: number; k: number; bottom: number; alpha: number; pulse: number; visible: boolean };
  type Glyph = { g: GlyphName; x: number; y: number };
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Below 834px the staff is its own band (see the styles above).
  const band = window.matchMedia('(max-width: 833px)');
  const E4 = 4 * 7 + 2; // treble staff bottom line, in diatonic steps from C0
  const G2 = 2 * 7 + 4; // bass staff bottom line
  const RANGE = { treble: [-3, 10], bass: [-4, 11] }; // B3 to A5, C2 to D4
  const paths = Object.fromEntries(
    Object.entries(GLYPHS).map(([k, d]) => [k, new Path2D(d)]),
  ) as Record<GlyphName, Path2D>;
  function init(canvas: HTMLCanvasElement) {
    let host = canvas.parentElement as HTMLElement;
    const ctx = canvas.getContext('2d')!;
    const staves = Number(canvas.dataset.staves || 2);
    let center = Number(canvas.dataset.center || 0.56);
    const css = getComputedStyle(document.documentElement);
    const INK = css.getPropertyValue('--ink').trim() || '#141414';
    const ACCENT = css.getPropertyValue('--verm').trim() || '#c63a2b';
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const N = 180;

    let lines: Line[] = [];
    let tops: number[] = [];
    let W = 0, H = 0, gap = 12, clefX = 0;
    let drawIn = reduce ? 1 : 0;
    const t0 = performance.now();
    let running = false;
    let last: { x: number; y: number } | null = null;
    let note: Note | null = null;
    let primed = false;
    let lastStep = -1;
    type Geom = { gap: number; tops: number[] };

    // The content column of the page, in canvas coordinates.
    function content() {
      const wrap = host.querySelector<HTMLElement>('.wrap');
      const c = canvas.getBoundingClientRect();
      if (!wrap) return { left: 0, right: W };
      const r = wrap.getBoundingClientRect();
      const st = getComputedStyle(wrap);
      return {
        left: r.left - c.left + parseFloat(st.paddingLeft),
        right: r.right - c.left - parseFloat(st.paddingRight),
      };
    }

    function size() {
      const r = canvas.getBoundingClientRect();
      W = r.width;
      H = r.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // An element's top within the host, ignoring transforms (the title may be
    // mid-animation when this runs).
    function offsetIn(el: HTMLElement) {
      let y = 0;
      for (let n: HTMLElement | null = el; n && n !== host; n = n.offsetParent as HTMLElement | null) y += n.offsetTop;
      return y;
    }

    // Where the staff belongs in the current host. With a page title, the
    // staff sits at a fixed distance below the title's top, which is the same
    // on every page, so the staff doesn't move as you navigate. Otherwise it
    // centers at data-center.
    function target(): Geom {
      if (band.matches && staves === 2) {
        if (!H || !W) return { gap: 10, tops: [0, 80] };
        const g = Math.max(9, Math.min(11.5, H / 14));
        const top = H / 2 - g * 6;
        return { gap: g, tops: [top, top + g * 8] };
      }
      const title = host.querySelector<HTMLElement>('[data-page-title]');
      const g = staves === 2 ? Math.max(9, Math.min(14, W / 100)) : Math.max(10, Math.min(14, H / 14));
      const staffH = g * 4;
      const total = staves === 2 ? staffH * 3 : staffH;
      const mid = title && staves === 2
        ? offsetIn(title) + 10 * g
        : H * center;
      const top = mid - total / 2;
      return { gap: g, tops: staves === 2 ? [top, top + staffH * 2] : [top] };
    }

    // Lays out lines and clefs for a given geometry, keeping the lines' motion.
    function build(g: Geom) {
      gap = g.gap;
      tops = g.tops;
      const ys: number[] = [];
      for (const t of tops) for (let l = 0; l < 5; l++) ys.push(t + l * gap);
      const prev = lines;
      lines = ys.map((y, i) => ({ y, d: prev[i]?.d ?? new Float32Array(N), v: prev[i]?.v ?? new Float32Array(N) }));
      const col = content();
      clefX = Math.max(gap * 0.6, col.left - gap * 4);
    }

    function layout() {
      size();
      build(target());
      draw();
    }

    // After a page change: the canvas now sits in the new page's header, in
    // the same place as before (see target()).
    function rehost(nextCenter: number) {
      detach();
      host = canvas.parentElement as HTMLElement;
      attach();
      center = nextCenter;
      note = null;
      last = null;
      size();
      build(target());
      draw();
      kick();
    }

    // Nearest staff step to a y position, and where it sits.
    function snap(y: number) {
      const half = gap / 2;
      let s = 0;
      if (tops.length === 2 && Math.abs(y - (tops[1] + 2 * gap)) < Math.abs(y - (tops[0] + 2 * gap))) s = 1;
      const bottom = tops[s] + 4 * gap;
      const base = s === 0 ? E4 : G2;
      const [lo, hi] = s === 0 ? RANGE.treble : RANGE.bass;
      const k = Math.max(lo, Math.min(hi, Math.round((bottom - y) / half)));
      return { step: base + k, y: bottom - k * half, k, bottom };
    }

    function inZone(y: number) {
      return y > tops[0] - gap * 2 && y < tops[tops.length - 1] + gap * 7;
    }

    const easeOut = (t: number) => 1 - Math.pow(1 - Math.min(1, Math.max(0, t)), 3);
    const shown = (x: number, reach: number) => Math.min(1, Math.max(0, (reach - x) / (gap * 3)));

    function glyph(g: Glyph, scale = 1) {
      ctx.save();
      ctx.translate(g.x, g.y);
      ctx.scale(gap * scale, gap * scale);
      ctx.fill(paths[g.g]);
      ctx.restore();
    }

    function drawClefs(reach: number) {
      const a = shown(clefX, reach);
      if (!a || tops.length < 2) return;
      ctx.save();
      ctx.fillStyle = INK;
      ctx.globalAlpha = 0.3 * a;
      glyph({ g: 'gClef', x: clefX, y: tops[0] + 3 * gap });
      glyph({ g: 'fClef', x: clefX, y: tops[1] + gap });
      ctx.restore();
    }

    function drawNote() {
      if (!note || note.alpha <= 0.01) return;
      const rx = gap * 0.68, ry = gap * 0.5;
      const s = 1 + note.pulse * 0.25;
      ctx.save();
      ctx.globalAlpha = note.alpha;
      ctx.strokeStyle = ACCENT;
      ctx.fillStyle = ACCENT;
      ctx.lineWidth = 1;
      // Ledger lines above or below the staff.
      for (let lk = -2; lk >= note.k; lk -= 2) {
        const ly = note.bottom - lk * (gap / 2);
        ctx.beginPath(); ctx.moveTo(note.x - rx * 1.7, ly); ctx.lineTo(note.x + rx * 1.7, ly); ctx.stroke();
      }
      for (let uk = 10; uk <= note.k; uk += 2) {
        const uy = note.bottom - uk * (gap / 2);
        ctx.beginPath(); ctx.moveTo(note.x - rx * 1.7, uy); ctx.lineTo(note.x + rx * 1.7, uy); ctx.stroke();
      }
      // Hollow, tilted notehead.
      ctx.translate(note.x, note.y);
      ctx.scale(s, s);
      ctx.beginPath();
      ctx.ellipse(0, 0, rx, ry, -0.35, 0, Math.PI * 2);
      ctx.ellipse(0, 0, rx * 0.62, ry * 0.34, -0.62, 0, Math.PI * 2, true);
      ctx.fill('evenodd');
      // Stem up on the lower half of a staff, down on the upper half.
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      if (note.k < 4) { ctx.moveTo(rx * 0.9, -ry * 0.25); ctx.lineTo(rx * 0.9, -gap * 3.5); }
      else { ctx.moveTo(-rx * 0.9, ry * 0.25); ctx.lineTo(-rx * 0.9, gap * 3.5); }
      ctx.stroke();
      ctx.restore();
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = INK;
      ctx.lineWidth = 1;
      ctx.globalAlpha = 0.16;
      const reach = W * easeOut(drawIn);
      for (const ln of lines) {
        ctx.beginPath();
        for (let i = 0; i < N; i++) {
          const x = (i / (N - 1)) * W;
          if (x > reach) break;
          const y = ln.y + ln.d[i];
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      drawClefs(reach);
      drawNote();
    }

    function step() {
      let energy = 0;
      if (drawIn < 1) {
        drawIn = (performance.now() - t0) / 1600;
        energy = 1;
      }
      for (const { d, v } of lines) {
        for (let i = 1; i < N - 1; i++) {
          const a = 0.28 * (d[i - 1] + d[i + 1] - 2 * d[i]) - 0.02 * d[i];
          v[i] = (v[i] + a) * 0.93;
        }
        for (let j = 1; j < N - 1; j++) {
          d[j] += v[j];
          energy += Math.abs(v[j]) + Math.abs(d[j]) * 0.05;
        }
      }
      if (note) {
        const target = note.visible ? 1 : 0;
        note.alpha += (target - note.alpha) * 0.2;
        note.pulse *= 0.9;
        if (Math.abs(target - note.alpha) > 0.01 || note.pulse > 0.01) energy += 1;
      }
      draw();
      if (energy > 0.04) requestAnimationFrame(step);
      else running = false;
    }

    const kick = () => {
      if (!running) {
        running = true;
        requestAnimationFrame(step);
      }
    };

    const local = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };

    // Sample files are fetched only once the visitor reaches the staff.
    function warm() {
      if (primed) return;
      primed = true;
      prime();
    }

    function ripple(x: number, y: number, amount: number) {
      if (reduce) return;
      const nearest = lines.reduce((a, b) => (Math.abs(b.y - y) < Math.abs(a.y - y) ? b : a));
      const i = Math.round((x / W) * (N - 1));
      for (let o = -3; o <= 3; o++) {
        const q = i + o;
        if (q > 0 && q < N - 1) nearest.v[q] += amount * (1 - Math.abs(o) / 4);
      }
    }

    // Links, buttons and any text marked data-staff-quiet get a margin where
    // the staff steps aside: no half note, no sound, the normal cursor. Marked
    // text is measured line by line, so the zone hugs the words.
    const QUIET = 'a, button, [data-staff-quiet]';
    const PAD = 12;
    function quiet(e: PointerEvent) {
      if ((e.target as HTMLElement).closest('a, button')) return true;
      const { clientX: x, clientY: y } = e;
      for (const el of host.querySelectorAll<HTMLElement>(QUIET)) {
        let rects: DOMRect[] = [el.getBoundingClientRect()];
        if (el.matches('[data-staff-quiet]')) {
          const range = document.createRange();
          range.selectNodeContents(el);
          rects = [...range.getClientRects()];
        }
        for (const r of rects) {
          if (x > r.left - PAD && x < r.right + PAD && y > r.top - PAD && y < r.bottom + PAD) return true;
        }
      }
      return false;
    }

    function onMove(e: PointerEvent) {
      const p = local(e);
      if (inZone(p.y)) warm();
      if (last && !reduce) {
        const dy = p.y - last.y;
        for (const ln of lines) {
          if ((last.y - ln.y) * (p.y - ln.y) <= 0) {
            const i = Math.round((p.x / W) * (N - 1));
            const push = Math.max(-3.5, Math.min(3.5, dy * 0.3));
            for (let o = -4; o <= 4; o++) {
              const q = i + o;
              if (q > 0 && q < N - 1) ln.v[q] += push * (1 - Math.abs(o) / 5);
            }
          }
        }
      }
      last = p;
      if (e.pointerType !== 'mouse') return kick();
      if (!quiet(e) && inZone(p.y)) {
        const sn = snap(p.y);
        if (sn.step !== lastStep) { lastStep = sn.step; prefetch([midiOfStep(sn.step)]); }
        note = { ...(note || { alpha: 0, pulse: 0 }), x: p.x, y: sn.y, step: sn.step, k: sn.k, bottom: sn.bottom, visible: true };
        host.classList.add('on-staff');
      } else {
        if (note) note.visible = false;
        host.classList.remove('on-staff');
      }
      kick();
    }

    function onLeave(e: PointerEvent) {
      last = null;
      // Touch fires pointerleave when the finger lifts; a tapped note stays
      // lit until its own timer clears it.
      if (e.pointerType !== 'mouse') return;
      if (note) note.visible = false;
      host.classList.remove('on-staff');
      kick();
    }

    let tapTimer = 0;
    // Touch: play on a tap that ends where it started, so a swipe through the
    // staff scrolls the page instead of playing notes.
    let touchStart: { x: number; y: number; t: number } | null = null;
    function onDown(e: PointerEvent) {
      if (e.pointerType !== 'mouse') {
        touchStart = { x: e.clientX, y: e.clientY, t: performance.now() };
        return;
      }
      strike(e);
    }
    function onUp(e: PointerEvent) {
      if (e.pointerType === 'mouse' || !touchStart) return;
      const moved = Math.hypot(e.clientX - touchStart.x, e.clientY - touchStart.y);
      const quick = performance.now() - touchStart.t < 600;
      touchStart = null;
      if (moved < 10 && quick) strike(e);
    }
    const onCancel = () => (touchStart = null);
    function strike(e: PointerEvent) {
      if (quiet(e)) return;
      const p = local(e);
      if (!inZone(p.y)) return;
      warm();
      const touch = e.pointerType !== 'mouse';
      const sn = snap(p.y);
      note = { ...(note || { alpha: 0, pulse: 0 }), x: p.x, y: sn.y, step: sn.step, k: sn.k, bottom: sn.bottom, visible: true, pulse: reduce ? 0 : 1 };
      if (touch) {
        clearTimeout(tapTimer);
        tapTimer = window.setTimeout(() => { if (note) note.visible = false; kick(); }, 1500);
      }
      play([midiOfStep(sn.step)]);
      ripple(p.x, sn.y, 1.6);
      kick();
    }

    function attach() {
      host.addEventListener('pointermove', onMove);
      host.addEventListener('pointerleave', onLeave);
      host.addEventListener('pointerdown', onDown);
      host.addEventListener('pointerup', onUp);
      host.addEventListener('pointercancel', onCancel);
    }
    function detach() {
      host.removeEventListener('pointerup', onUp);
      host.removeEventListener('pointercancel', onCancel);
      host.removeEventListener('pointermove', onMove);
      host.removeEventListener('pointerleave', onLeave);
      host.removeEventListener('pointerdown', onDown);
      host.classList.remove('on-staff');
    }

    layout();
    // Lay out again whenever the canvas changes size: on resize, and when the
    // header grows as web fonts load (otherwise the drawing would stretch).
    new ResizeObserver(() => {
      const r = canvas.getBoundingClientRect();
      if (Math.abs(r.width - W) < 0.5 && Math.abs(r.height - H) < 0.5) return;
      layout();
    }).observe(canvas);
    document.fonts?.ready.then(layout);
    attach();
    kick();
    return { rehost };
  }

  // One staff for the whole visit: the page router keeps this canvas across
  // pages (transition:persist), so a note keeps ringing as you navigate.
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.staff');
  const staff = canvas ? init(canvas) : null;
  let nextCenter = 0.56;
  document.addEventListener('astro:before-swap', (e) => {
    const c = e.newDocument.querySelector<HTMLCanvasElement>('canvas.staff');
    nextCenter = Number(c?.dataset.center || 0.56);
  });
  document.addEventListener('astro:after-swap', () => {
    if (!staff || !canvas?.isConnected) return;
    canvas.dataset.center = String(nextCenter);
    staff.rehost(nextCenter);
  });
</script>
